# The opening, mode menu, then story or VS. Story uses one player selection,
# difficulty, introduction, loading, CPU fights and the original story demos.
# VS supports two human players. The skills run from the converted FM2K
# data (assets/…/script.lton through src/script.lh, TechnicalDocuments/0012).
#
#   select         up / down a character, left / right its palette; a button
#                  locks it, then left / right chooses support, A/C/E/F confirms
#   arrows         move / jump / crouch (and command motions)
#   z x c a s d    buttons A B C D E F
#   u h j k        2P up / left / down / right
#   l ; ' o p [    2P buttons A B C D E F
#   F1             show boxes      1-8         palette
#   F2             opponent at 1 life (the next hit KOs); F5 sound log
#   F3 / F4        (VS) the CPU drives 1P / 2P, or not (development)
#   t              (select screen) the stage: random, or one of them in turn
#   F8             reload changed code and return to title (development)
#   escape         back (quit on title); pause/resume during battle
#   return         confirm menus; pause/resume during battle (gamepad Start)
#
# What a button or motion does comes from the character's command table.
module^vp.main

import^love.graphics
import^love.keyboard
import^love.event
import^love.timer
import^love.math
import^love.audio
import^love.filesystem
import^love.window
import^std.math

require^"src/arena.lh"
require^"src/fighter.lh"
require^"src/shake.lh"
require^"src/sprite.lh"
require^"src/script.lh"
require^"src/stage.lh"
require^"src/hud.lh"
require^"src/round.lh"
require^"src/select.lh"
require^"src/title.lh"
require^"src/preload.lh"
require^"src/resource.lh"
require^"src/story.lh"
require^"src/practicemenu.lh"
require^"src/replaylist.lh"
require^"src/replay.lh"
require^"src/rng.lh"
require^"src/snapshot.lh"
require^"src/net.lh"
require^"src/lanmenu.lh"
require^"src/roommenu.lh"
require^"src/online.lh"
require^"src/cpu.lh"
require^"src/input.lh"
require^"src/media.lh"
require^"src/settings.lh"
require^"src/locale.lh"

let^Fighter = vp.fighter.Fighter
let^Key = love.keyboard.Key

let^FRAME = 1 / 100          # FM2K runs at 100 fps

# The world is the stage's 1280x960. The original shows a 640x480 part of it at
# 1:1 and scrolls; the window here is that view at twice the size.
let^WORLD_W = 1280
let^WORLD_H = 960
let^VIEW_W = 640
let^VIEW_H = 480
let^SCALE = 2
# The window conf.lton opens; a larger one (fullscreen) shows the same,
# scaled to fit and centred, with black bars.
let^WINDOW_W = VIEW_W * SCALE
let^WINDOW_H = VIEW_H * SCALE
# Measured in the original's memory (TechnicalDocuments/0011).
let^GROUND = 920
let^WALL_GROUND = 50         # Original EXE uses [50, 1230] on the ground and in the air.
let^START_X = 270            # the round starts with 1P / 2P at 640 -/+ this
let^VIEW_EDGE = 50           # how close to the view's edge a fighter may go

let^SYSTEM = "assets/system/ヴァンガードプリンセス"
let^STAGES : t^{string^[]} = { "スクール", "プール", "神社", "瓦礫", "夜", "丘", "ラスト" }

# The match's fighters and stage are made when a battle starts.
var^me = Fighter.new("assets/characters/ゆい", WORLD_W / 2 - START_X, GROUND)
var^foe = Fighter.new("assets/characters/ゆい", WORLD_W / 2 + START_X, GROUND)
var^hud = vp.hud.Hud.new()
var^flow = vp.round.Round.new()
var^stage = vp.stage.Stage.new()
var^selecting : vp.select.Select|nil^= nil^    # the select screen, while it is up
var^demos = vp.title.Demos.new()
var^scene : vp.title.Scene|nil^= nil^           # the opening or the title screen
var^opening = true^                              # which of the two it is
var^stageChoice = 0            # T on the select screen: 0 random, 1.. a fixed stage (debugging)
var^upPressed = false^
var^downPressed = false^
var^leftPressed = false^
var^rightPressed = false^
var^pressed2 = 0
var^leftPressed2 = false^
var^rightPressed2 = false^
var^upPressed2 = false^
var^downPressed2 = false^
let^clear2 = p^{ pressed2 := 0 upPressed2 := false^ downPressed2 := false^ leftPressed2 := false^ rightPressed2 := false^ }
var^storyMode = true^
# PRACTICE MODE (the menu's third item): VS's select and match, in practice
# from the start (system variable 140 = 500), the clock off, and ESC / Select
# back to the select screen (TechnicalDocuments/0145).
var^practiceMode = false^
var^campaign : vp.story.State|nil^= nil^
var^brain : vp.cpu.Brain|nil^= nil^
var^demoBrain : vp.cpu.Brain|nil^= nil^
var^attract = false^
var^attractLoaded = false^
var^attractSeconds = 0
var^attractNames : t^{string^[]} = {}
var^attractSupports : t^{number^[]} = {}
var^matchSeconds = 60
var^paused = false^
# Replays (TechnicalDocuments/0155): VS matches are recorded, and one chosen
# from WATCH REPLAY is played from its inputs.
var^recording : vp.replay.Tape|nil^= nil^
var^playing : vp.replay.Tape|nil^= nil^
var^replayFrame = 0            # the next of the played replay's frames
# Playing a replay keeps a snapshot every second (TechnicalDocuments/0156):
# left goes back to the last one before now, right holds fast forward.
var^replaySnapshots : t^{[number^]:Saved|nil^} = {}
let^SNAPSHOT_EVERY = 100
let^FAST_FORWARD = 4           # frames a frame while right is held
let^REWIND_REPEAT = 0.25       # seconds between steps back while left is held
let^REWIND_MARGIN = 30         # a step back from just past a snapshot goes to the one before
var^rewindTimer = 0
var^fastForward = false^
var^leavingReplay = false^     # a played replay has ended; the mode menu is loading
var^replayMatched = false^     # the last replay ended as it was recorded
var^lastReplay = ""            # the last saved replay's file name
var^matchSeed = 0              # the simulation's seed for the match being prepared
# LAN VS (TechnicalDocuments/0157): a linked session's select screen and
# matches. Each side plays its own; the other's input arrives over src/net.lh
# INPUT_DELAY frames ahead; missing input is predicted within ROLLBACK_MAX.
var^netplay = false^
var^netRound = 0               # the select round (and match) of the session
var^netFrame = 0               # the next battle frame of a LAN match
var^netWaiting = 0             # frames in a row waited for the other side's input
let^ROLLBACK_MAX = 4           # LAN: bound prediction and each correction's work
let^Rollback = def^{
    self^{
        saved : Saved|nil^= nil^,
        spare : Saved|nil^= nil^,
        base = 0,
        used : t^{[number^]:number^|nil^} = {},
        ending = false^,
        resimulating = false^,
        corrections = 0, predicted = 0, snapshots = 0, replayed = 0,
        maxDepth = 0, waits = 0,
        sums : t^{[number^]:vp.net.Sum|nil^} = {},
        sentSum = 0,
    },
}
var^rollback = Rollback.new()
var^netFont : love.graphics.Font|nil^= nil^
var^cpuFirst = false^          # F3 / F4 in VS: the CPU drives 1P / 2P (in LAN VS, F3 this side)
var^cpuSecond = false^
let^CPU_LEVEL = 100
var^vsSeconds = 60             # VS rounds' length (tests shorten it)
var^vsSeed = -1                # tests may fix the seed; -1 chooses one normally
let^MatchSetup = t^{ name1:string^, colour1:number^, name2:string^, colour2:number^ }
var^setup : MatchSetup = { name1 = "ゆい", colour1 = 0, name2 = "ゆい", colour2 = 0 }
var^reloadPending = false^
var^collectSceneGarbage = false^

let^inBattle = f^-> bool^{
    let^st = campaign
    return^initialized and^scene is^nil^ and^selecting is^nil^ and^pending is^nil^ and^!matchIntro and^introCatchup = 0 and^(st is^nil^ or^st.phase = "battle")
}
let^togglePause = p^{
    paused := !paused
    let^sound = vp.arena.sound($"{SYSTEM}/sounds/0002.wav", false^)
    if^sound != nil^ { sound.setLooping(false^) sound.play() }
    clock := 0
    pressed := 0
    upPressed := false^
    downPressed := false^
    leftPressed := false^
    rightPressed := false^
    clear2()
}

# FM2K skill numbers: the character's built-in skills (its .player settings)
# and what its commands map A / B / C to.
let^STAND = 1
let^FORWARD = 2
let^BACK = 3
let^JUMP_UP = 4
let^JUMP_FORWARD = 5
let^JUMP_BACK = 6
let^FALL = 7
let^CROUCH_DOWN = 11
let^CROUCH = 12
let^STAND_UP = 13
let^START = 21
let^SHADOW = 28          # the built-in shadow skill

let^ROUND_SECONDS = 60   # as the original shows (the time is not in its data files)
var^clock = 0
var^camX = (WORLD_W - VIEW_W) / 2    # the view's top-left in the world
var^camY = WORLD_H - VIEW_H
var^aimX = camX                      # where the camera heads next frame
var^aimY = camY
# The round's clock, 100 frames a second; it runs only while they fight. It
# shows 60 through the start and 59 from the fight's first frame (as the
# original); the round time the skills read is one frame behind (59 through
# the start: the system's layout 5 checks for it to show "60", else "∞").
var^roundFrames = ROUND_SECONDS * 100
var^frame = 0
var^matchLoading = false^
var^introCatchup = 0
var^matchArena : vp.arena.Arena|nil^= nil^
var^matchIntro = false^      # shared VS presentation during asynchronous loading
let^LOAD_SLICE = 0.004        # main-thread adoption / GPU upload budget per update
var^pending : vp.preload.Load|nil^= nil^
var^pendingKind = ""
var^initialized = false^
var^matchStage = 0
# Let the second choice's flash and sound play before preparing the match.
let^LOAD_DELAY = 50
var^wasTiming = false^
var^lastSkill = ""            # skill changes are printed to the console, for debugging
var^showBoxes = false^
var^pressed = 0               # buttons pressed since the last frame (A = 1 ... F = 32)
var^dummyGuard = 0            # 2P's guard (G, or PRACTICE MODE's menu): 0 none, 1 everything, 2 standing, 3 crouching
var^soundLog = false^         # L: print every sound to the console
let^GUARD_NAMES : t^{string^[]} = { "off", "all", "standing", "crouching" }

# Skills the player may leave at any moment on the ground / in the air.
let^groundIdle = f^n:number^-> bool^{
    return^n = STAND or^n = FORWARD or^n = BACK or^n = CROUCH or^n = CROUCH_DOWN or^n = STAND_UP
}
let^airIdle = f^n:number^-> bool^{
    return^n = JUMP_UP or^n = JUMP_FORWARD or^n = JUMP_BACK or^n = FALL
}
let^crouching = f^n:number^-> bool^{
    return^n = CROUCH or^n = CROUCH_DOWN
}

# Skills that end in a crouch: crouching and the command table's crouching moves.
let^endsCrouched = p^p:Fighter, n:number^-> bool^{
    if^crouching(n) { return^true^ }
    for^c in^p.commands {
        if^c.crouch = n and^c.stand != n { return^true^ }
    }
    return^false^
}

# What the built-in part of FM2K does: pick the next skill from the input.
# forward / back are relative to the way the fighter faces.
let^control = p^p:Fighter, up:bool^, down:bool^, forward:bool^, back:bool^, held:number^, cpu:vp.cpu.Brain|nil^{
    # Result scripts own the pose after KO. Even neutral input must not
    # replace a completed loss/victory script with standing or buffered attacks.
    if^flow.phase = "ko" or^flow.phase = "win" or^flow.phase = "end" or^me.life <= 0 or^foe.life <= 0 {
        p.recordHeld(5, 0)
        if^flow.phase = "ko" and^p.life > 0 and^p.stop <= 0 and^p.finished() and^p.airborne() and^!p.eventPending { p.start(FALL, 0) }
        return^
    }
    let^n = p.skillNo
    let^air = p.airborne()

    let^dx = if^forward: 1 el^back: -1 el^: 0;
    let^dy = if^up: 1 el^down: -1 el^: 0;
    if^cpu != nil^ { cpu.record(p) else^: p.recordHeld(5 + dx + 3 * dy, held) }
    # moveStep may have crossed the floor last tick. Let stepScript dispatch
    # landing before a ground command can clear its handler and vertical speed.
    if^p.stop > 0 or^p.eventPending or^p.landingDue() { return^ }

    # The command table (buttons, motions, jumps), where the running skill allows it.
    if^p.takeCommand(down) {
        if^cpu != nil^ { cpu.actions += 1 }
        return^
    }

    if^p.finished() {
        if^air {
            p.blocking := false^
            p.receiving := false^
            p.start(FALL, 0)           # the jump's motion and landing handler carry on
            return^
        }
        # On the ground, pick from this frame's input (below) rather than going
        # through standing first: a walk that runs off its end starts again at once.
        p.skillNo := -1
    elseif^air or^!groundIdle(n):
        return^
    }
    let^m = p.skillNo

    let^wasCrouched = m < 0 and^endsCrouched(p, n)
    if^down {
        if^!crouching(m) { p.begin(if^wasCrouched: CROUCH el^: CROUCH_DOWN;) }
    elseif^crouching(m) or^wasCrouched:
        p.begin(STAND_UP)
    elseif^forward:
        if^m != FORWARD { p.begin(FORWARD) }
    elseif^back:
        if^m != BACK { p.begin(BACK) }
    elseif^m != STAND and^m != STAND_UP:
        p.begin(STAND)
    }
}

# Hits: an attack box of a over a hurt box (not a push-only one) of b.
# vp.fighter.struck plays it out on both sides.
let^overlaps = p^a:Fighter, ba:vp.fighter.Box, b:Fighter, bb:vp.fighter.Box-> bool^{
    let^al, at, aw, ah = a.rect(ba)
    let^bl, bt, bw, bh = b.rect(bb)
    return^al < bl + bw and^bl < al + aw and^at < bt + bh and^bt < at + ah
}

let^strike = p^a:Fighter, b:Fighter {
    if^!b.hasHurtBoxes() { return^ }
    for^s1, atk in^a.hits {
        if^atk fits^vp.fighter.Box and^a.canHit(atk, b) {
            for^s2 from^0 to^19 {
                let^hurt = b.hurts[s2]
                if^hurt fits^vp.fighter.Box {
                    if^hurt.vulnerable and^hurt.w > 0 and^hurt.h > 0 {
                        if^overlaps(a, atk, b, hurt) {
                            if^b.owner != nil^ {
                                a.struck(atk, b, hurt.rate, false^, hurt.flags)
                                return^
                            }
                            # the spark goes where the two boxes meet
                            let^al, at, aw, ah = a.rect(atk)
                            let^bl, bt, bw, bh = b.rect(hurt)
                            let^hx = (std.math.max(al, bl) + std.math.min(al + aw, bl + bw)) / 2
                            let^hy = (std.math.max(at, bt) + std.math.min(at + ah, bt + bh)) / 2
                            # a hit count goes at the hurt box that was hit (its offset, not
                            # its middle), from where the defender stood (0018)
                            let^cx = b.x + hurt.x * b.facing
                            let^cy = b.y + hurt.y
                            let^comboMarker = b.v(128)
                            let^guarded, spark = a.struck(atk, b, hurt.rate, endsCrouched(b, b.skillNo), hurt.flags)
                            if^!guarded {
                                b.combo += 1
                                if^b.combo >= 2 { flow.showCombo(b.combo, cx, cy, comboMarker) }
                            }
                            # The attacker's spark, run as the attacker's object (0008).
                            if^spark > 0 { a.makeObject(spark, 0, hx, hy, 127) }
                            let^what = if^guarded: "guard" el^: "hit";
                            print($"{frame}: {what} {a.skillName} -> {b.skillName}  life {b.life}  spark {spark}")
                            return^
                        }
                    }
                }
            }
        }
    }
}

let^strikeTeam = p^a:Fighter, b:Fighter{
    if^!a.hasAttackBoxes() { return^ }
    strike(a, b)
    for^target in^b.objects { strike(a, target) }
}

# Puts a fighter where a round starts: its objects (and so its part of the
# HUD) go, its built-in start skill brings them back.
let^place = p^p:Fighter, x:number^, facing:number^{
    p.x := x
    p.y := GROUND
    p.vx := 0
    p.vy := 0
    p.ax := 0
    p.ay := 0
    p.facing := facing
    p.life := p.lifeMax
    p.objects := {}
    p.slots := {}
    p.hurts := {}
    p.hits := {}
    p.stop := 0
    p.cornerPush := 0
    p.trail := nil^
    p.baseDepth := if^facing = 1: 80 el^: 70;
    p.depth := p.baseDepth
    p.combo := 0
    p.damageHits := 0
    # A round starts clean: the character's variables (its objects and its
    # support read them; kept, the support stood frozen in last round's
    # win / loss pose) and whatever it left on the stage.
    p.vars := {}
    p.onSkill := {}
    p.onBlock := {}
    # and its look: はるか's victory (#22) fades her out (COLOR alpha 32) and
    # nothing in the next round's start sets COLOR again.
    p.blend := 0
    p.alpha := 1
    p.tintR := 0
    p.tintG := 0
    p.tintB := 0
    # The round starts with each character's built-in start skill, which also
    # puts up its part of the HUD (support gauge, stun, hit count, ...).
    p.begin(START)
    p.castShadow(SHADOW)
}

let^characterCode = p^p:Fighter-> number^{
    for^i, name in^vp.select.CHARACTERS {
        if^p.dir = $"assets/characters/{name}" { return^(i + 1) * 100 }
    }
    if^p.dir = "assets/characters/ヒルダ" { return^1100 }
    panic^$"Unknown match character: {p.dir}"
}

# Follow the fighters with the original integer half-step camera lag.
let^halfway = f^from:number^, to:number^-> number^{
    let^d = (to - from) / 2
    return^from + if^d < 0: d.ceil() el^: d.floor();
}

# It lags a frame: it heads for where the fighters were the frame before.
let^followCamera = p^{
    camX := halfway(camX, aimX).clamp(0, WORLD_W - VIEW_W)
    camY := halfway(camY, aimY).clamp(0, WORLD_H - VIEW_H)
    aimX := (me.x + foe.x) / 2 - VIEW_W / 2
    aimY := std.math.min(me.y, foe.y) - 320
}

# Shared fixed-step simulation also catches up newly loaded entrants, hidden.
let^stepFighters = p^{
    vp.fighter.setView(camX, camY)
    # The stage's walls, and the camera's: nobody leaves the view.
    for^p in^{ me, foe } {
        p.minX := std.math.max(WALL_GROUND, camX + VIEW_EDGE)
        p.maxX := std.math.min(WORLD_W - WALL_GROUND, camX + VIEW_W - VIEW_EDGE)
        p.minXAir := p.minX
        p.maxXAir := p.maxX
        p.wallMinX := camX + VIEW_EDGE
        p.wallMaxX := camX + VIEW_W - VIEW_EDGE
    }
    me.stepScript()
    foe.stepScript()
    me.stepObjectScripts()
    foe.stepObjectScripts()
    # a combo is over once its target is free to move again
    for^p in^{ me, foe } {
        if^groundIdle(p.skillNo) or^airIdle(p.skillNo) {
            p.combo := 0
            p.receiving := false^
            p.blocking := false^
        }
    }
    me.resetHitEvents() foe.resetHitEvents()
    me.offsetTeamAgainst(foe)
    strikeTeam(me, foe)
    strikeTeam(foe, me)
    for^o in^me.objects { strikeTeam(o, foe) }
    for^o in^foe.objects { strikeTeam(o, me) }
    me.moveStep() foe.moveStep()
    me.moveObjects() foe.moveObjects()
    me.pushAgainst(foe)
    me.finishHitEvents() foe.finishHitEvents()
    # Keep both fighters inside the current world and camera bounds.
    for^p in^{ me, foe } {
        if^p.airborne() { p.x := p.x.clamp(p.minXAir, p.maxXAir) else^: p.x := p.x.clamp(p.minX, p.maxX) }
    }
    followCamera()
    if^flow.fighting() { me.faceOpponent() foe.faceOpponent() }
}

let^startRound = p^{
    vp.shake.horizontal.reset()
    vp.shake.vertical.reset()
    # The demo bypasses portrait #25, which normally initializes variable 129.
    # Set both identities before any HUD layer can choose its name image.
    me.setv(129, characterCode(me))
    me.setv(130, characterCode(foe))
    hud.restart()
    place(me, WORLD_W / 2 - START_X, 1)
    place(foe, WORLD_W / 2 + START_X, -1)
    roundFrames := if^matchSeconds = 0: 100000000 el^: matchSeconds * 100;
    vp.fighter.setRound(roundFrames, flow.number)
    let^cpu = brain
    if^cpu != nil^ { cpu.reset() }
    let^firstCPU = demoBrain
    if^firstCPU != nil^ { firstCPU.reset() }
    camX := (WORLD_W - VIEW_W) / 2
    camY := WORLD_H - VIEW_H
    aimX := camX
    aimY := camY
}

# Drop script graphs and suspended skill coroutines as well as native assets.
# Collect after the retiring scene's stack has returned.
let^releaseBattle = p^{
    brain := nil^
    demoBrain := nil^
    me := Fighter.new("assets/characters/ゆい", WORLD_W / 2 - START_X, GROUND)
    foe := Fighter.new("assets/characters/ゆい", WORLD_W / 2 + START_X, GROUND)
    stage := vp.stage.Stage.new()
    flow := vp.round.load(SYSTEM)
    collectSceneGarbage := true^
}

let^endAttract = p^animate:bool^{
    let^l = pending
    if^l != nil^ { l.batch.cancel() pending := nil^ }
    love.audio.stop()
    if^attractLoaded { vp.arena.pop() }
    vp.arena.pop() # Previous opening scene.
    attract := false^
    attractLoaded := false^
    releaseBattle()
    paused := false^
    clock := 0
    pressed := 0
    upPressed := false^
    downPressed := false^
    leftPressed := false^
    rightPressed := false^
    clear2()
    vp.fighter.clearSystemVars()
    opening := true^
    vp.arena.push("opening")
    scene := vp.title.openingScreen(animate)
}

# The match arena goes; the select arena remains (TechnicalDocuments/0023).
let^toSelect = p^{
    if^attract { endAttract(true^) return^ }
    if^playing != nil^ { endReplay(true^) return^ }
    if^netplay and^vp.net.isOnline() {
        saveRecording() vp.net.finishOnline() endNet("") return^
    }
    saveRecording()
    if^netplay { netRound += 1 }
    love.audio.stop()              # the match's music and sounds end with it
    vp.arena.pop()
    matchArena := nil^
    matchLoading := false^
    let^st = campaign
    let^won = flow.wins1 >= flow.toWin
    # Capture the participants before releaseBattle replaces both fighters.
    let^row1 = (characterCode(me) / 100).floor() - 1
    let^row2 = (characterCode(foe) / 100).floor() - 1
    let^support1 = me.v(142)
    let^support2 = me.v(143)
    let^colour1 = me.palette
    let^colour2 = foe.palette
    let^bossDown = won and^foe.dir = "assets/characters/ヒルダ"
    releaseBattle()
    if^st != nil^ {
        let^running : vp.story.State = st
        # Beating the final boss ends in her white-out (ヒルダ #23 -> #302).
        running.whiteout := bossDown
        if^bossDown { running.ending := true^ }
        if^won { running.advance()
        else^: running.enter("continue") running.continueChoice := 0 }
        return^
    }
    let^s = vp.select.load(SYSTEM, storyMode)
    s.solo := practiceMode
    if^!storyMode {
        for^k, side in^s.sides {
            side.row := if^k = 0: row1 el^: row2;
            side.colour := if^k = 0: colour1 el^: colour2;
            s.showPortrait(k)
            s.restoreSupport(k, if^k = 0: support1 el^: support2;)
        }
    }
    selecting := s
}

# Select owns the small portrait scripts. The stage is ready before this
# shared presentation; character and support resources load underneath it.
let^beginPresentation = p^name1:string^, colour1:number^, name2:string^, colour2:number^, stageName:string^, seconds:number^{
    matchIntro := true^
    # Seeded here for the presentation's own draws (the stage's scripts), and
    # again as the match starts (startBattle).
    vp.rng.seed(matchSeed)
    love.audio.stop()
    roundFrames := if^seconds = 0: 100000000 el^: seconds * 100;
    vp.fighter.setRound(roundFrames, 1)
    flow := vp.round.load(SYSTEM)
    flow.preparing := true^
    flow.externalPresentation := true^
    flow.portrait(name1, colour1, 0)
    flow.portrait(name2, vp.select.opponentColour(name1, colour1, name2, colour2), 1)
    for^side from^0 to^1 {
        let^name = if^side = 0: name1 el^: name2;
        var^code = 1100
        for^i, candidate in^vp.select.CHARACTERS { if^candidate = name { code := (i + 1) * 100 } }
        me.setv(129 + side, code)
    }
    stage := vp.stage.load($"assets/stages/{stageName}")
    for^layer in^stage.layers { layer.mutedSounds[1] := true^ }
    camX := (WORLD_W - VIEW_W) / 2
    camY := WORLD_H - VIEW_H
    vp.fighter.setView(camX, camY)
    stage.step()
    let^music = vp.arena.sound($"assets/stages/{stageName}/sounds/0001.wav", true^)
    flow.music := music
    if^music != nil^ { music.play() }
}

let^loadMatch = p^s:vp.select.Select {
    if^s.story {
        let^name, colour = s.chosen(0)
        let^st = vp.story.State.new(name, colour, me.v(142))
        campaign := st
        let^l = vp.preload.Load.new("story")
        l.batch.request(st.intro, "image", false^)
        pending := l
        pendingKind := "briefing"
        matchLoading := true^
        return^
    }
    matchLoading := true^
    matchStage := if^stageChoice > 0: stageChoice - 1 el^: love.math.random(0, STAGES.length^ - 1);
    let^name1, colour1 = s.chosen(0)
    let^name2, colour2 = s.chosen(1)
    setup := { name1 = name1, colour1 = colour1, name2 = name2, colour2 = colour2 }
    matchSeed := if^vsSeed >= 0: vsSeed el^: vp.rng.fresh();
    if^netplay {
        if^vp.net.hosting() {
            vp.net.offer({ match = netRound, seed = matchSeed, stage = matchStage, seconds = vsSeconds, toWin = flow.toWin })
        else^:
            let^given = vp.net.hostSetup()
            matchSeed := given.seed
            matchStage := given.stage
            vsSeconds := given.seconds
        }
    }
    let^l = vp.preload.Load.new("match")
    l.add($"assets/stages/{STAGES[matchStage] ?? "スクール"}", false^)
    pending := l
    pendingKind := "match-stage"
}

# The chosen characters, their colours and a stage at random; the supports
# chosen on the select screen are in system variables 142 / 143.
let^startBattle = p^{
    brain := nil^
    demoBrain := nil^
    matchSeconds := vsRoundSeconds()
    let^name1 = setup.name1
    let^colour1 = setup.colour1
    let^name2 = setup.name2
    let^colour2 = setup.colour2
    # The match starts from the same state however long its loading took:
    # always at the presentation's wait for assets (completeLoad), and from
    # the seed.
    vp.rng.seed(matchSeed)
    if^netplay {
        vp.net.resetMatch(netRound)
        netFrame := 0
        netWaiting := 0
        rollback.saved := nil^
        rollback.spare := nil^
        rollback.base := 0
        rollback.used := {}
        rollback.ending := false^
        rollback.corrections := 0
        rollback.predicted := 0
        rollback.snapshots := 0
        rollback.replayed := 0
        rollback.maxDepth := 0
        rollback.waits := 0
        rollback.sums := {}
        rollback.sentSum := 0
        flow.toWin := vp.net.hostSetup().toWin
    }
    let^tape = playing
    if^tape != nil^ {
        flow.toWin := tape.toWin
    elseif^!practiceMode:
        let^rec = vp.replay.Tape.new()
        rec.seed := matchSeed
        rec.char1 := characterIndex(name1)
        rec.char2 := characterIndex(name2)
        rec.colour1 := colour1
        rec.colour2 := colour2
        rec.support1 := me.v(142)
        rec.support2 := me.v(143)
        rec.stage := matchStage
        rec.seconds := matchSeconds
        rec.toWin := flow.toWin
        recording := rec
    }
    if^!matchIntro { love.audio.stop() }
    me := Fighter.new($"assets/characters/{name1}", WORLD_W / 2 - START_X, GROUND)
    foe := Fighter.new($"assets/characters/{name2}", WORLD_W / 2 + START_X, GROUND)
    (vp.select.scriptFor(name1, me.v(142))).install(me)
    (vp.select.scriptFor(name2, me.v(143))).install(foe)
    me.palette := colour1
    foe.palette := vp.select.opponentColour(name1, colour1, name2, colour2)
    me.enemy := foe
    foe.enemy := me
    me.externalIntroPortrait := true^
    foe.externalIntroPortrait := true^
    flow.preparing := false^
    matchIntro := false^
    selecting := nil^
    startRound()
    introCatchup := flow.presentationFrames
}

# A VS round's length: none in practice, the replay's when playing one.
let^vsRoundSeconds = f^-> number^{
    let^tape = playing
    return^if^practiceMode: 0 el^tape != nil^: tape.seconds el^: vsSeconds;
}

let^characterIndex = f^name:string^-> number^{
    for^i, candidate in^vp.select.CHARACTERS { if^candidate = name { return^i } }
    return^0
}

let^nameOf = f^p:Fighter-> string^{
    let^parts = p.dir.split("/")
    return^parts[parts.length^ - 1] ?? ""
}

# Plays replays/<name> (WATCH REPLAY): the recorded match's setup, loaded the
# way VS loads its own, over the mode menu until its presentation starts.
let^startReplay = p^name:string^{
    let^tape = vp.replay.load(name)
    if^tape is^nil^ { return^ }
    let^name1 = vp.select.CHARACTERS[tape.char1]
    let^name2 = vp.select.CHARACTERS[tape.char2]
    if^name1 is^nil^ or^name2 is^nil^ { print($"Replay of unknown characters: {name}") return^ }
    playing := tape
    replayFrame := 0
    replaySnapshots := {}
    replayMatched := false^
    storyMode := false^
    practiceMode := false^
    setup := { name1 = name1, colour1 = tape.colour1, name2 = name2, colour2 = tape.colour2 }
    matchSeed := tape.seed
    matchStage := tape.stage
    me.setv(142, tape.support1)
    me.setv(143, tape.support2)
    matchLoading := true^
    let^l = vp.preload.Load.new("match")
    l.add($"assets/stages/{STAGES[matchStage] ?? "スクール"}", false^)
    pending := l
    pendingKind := "match-stage"
}

# The played replay is over (or ESC stopped it): back to the mode menu.
let^endReplay = p^finished:bool^{
    let^tape = playing
    if^tape != nil^ {
        replayMatched := finished and^replayFrame = tape.frames() and^flow.wins1 = tape.wins1 and^flow.wins2 = tape.wins2 and^
            me.life = tape.life1 and^foe.life = tape.life2
        if^finished {
            let^verdict = if^replayMatched: "as recorded" el^: "NOT as recorded";
            print($"Replay ended {verdict}: frames {replayFrame} / {tape.frames()}, wins {flow.wins1}-{flow.wins2} / {tape.wins1}-{tape.wins2}, life {me.life} {foe.life} / {tape.life1} {tape.life2}")
        }
    }
    playing := nil^
    replaySnapshots := {}
    fastForward := false^
    love.audio.stop()
    if^matchArena != nil^ { vp.arena.pop() matchArena := nil^ }
    matchLoading := false^
    paused := false^
    releaseBattle()
    leavingReplay := true^
    prepare("title")
}

# A linked LAN session begins: both go to VS's select screen.
let^startNetSelect = p^{
    vp.lanmenu.close()
    netplay := true^
    netRound := 1
    storyMode := false^
    practiceMode := false^
    cpuSecond := false^
    vp.net.resetMatch(0)
    prepare("select")
}

# The LAN session ends (ESC, or the link was lost): back to the mode menu,
# with `why` shown there unless it is "".
let^endNet = p^why:string^{
    let^keepRoom = vp.net.isOnline() and^vp.online.inRoom()
    if^keepRoom {
        if^vp.net.active() { vp.net.abortOnline() else^: vp.net.finishOnline() }
    else^: vp.net.leave() }
    netplay := false^
    rollback.saved := nil^
    rollback.spare := nil^
    rollback.used := {}
    rollback.sums := {}
    let^l = pending
    if^l != nil^ { l.batch.cancel() pending := nil^ }
    love.audio.stop()
    if^matchArena != nil^ { vp.arena.pop() matchArena := nil^ }
    matchLoading := false^
    matchIntro := false^
    introCatchup := 0
    flow.preparing := false^
    flow.externalPresentation := false^
    paused := false^
    recording := nil^
    campaign := nil^
    releaseBattle()
    # From a match nothing is left to show while the menu loads.
    if^selecting is^nil^ { leavingReplay := true^ }
    if^keepRoom { vp.lanmenu.openRoom()
    elseif^why != "": vp.lanmenu.showMessage(why) }
    prepare("title")
}

# Before releaseBattle: the finished VS match's result, and the file.
let^saveRecording = p^{
    let^rec = recording
    recording := nil^
    if^rec is^nil^ { return^ }
    rec.wins1 := flow.wins1
    rec.wins2 := flow.wins2
    rec.life1 := me.life
    rec.life2 := foe.life
    lastReplay := vp.replay.save(rec, nameOf(me), nameOf(foe))
}

let^queueAttract = p^{
    attract := true^
    attractLoaded := false^
    attractSeconds := 0
    attractNames := {}
    attractSupports := {}
    matchStage := love.math.random(0, STAGES.length^ - 1)
    let^l = vp.preload.Load.new("attract")
    for^k from^0 to^1 {
        let^name = vp.select.CHARACTERS[love.math.random(0, 9)] ?? "ゆい"
        let^support = love.math.random(101, 105)
        attractNames.push^(name)
        attractSupports.push^(support)
        l.character($"assets/characters/{name}", support)
        l.batch.request($"assets/characters/{name}/cpu.lton", "lton", false^)
    }
    l.add($"assets/stages/{STAGES[matchStage] ?? "スクール"}", false^)
    pending := l
    pendingKind := "attract"
}

let^startAttract = p^{
    let^name1 = attractNames[0] ?? "ゆい"
    let^name2 = attractNames[1] ?? "ゆい"
    vp.fighter.clearSystemVars()
    me.setv(142, attractSupports[0] ?? 101)
    me.setv(143, attractSupports[1] ?? 101)
    me := Fighter.new($"assets/characters/{name1}", WORLD_W / 2 - START_X, GROUND)
    foe := Fighter.new($"assets/characters/{name2}", WORLD_W / 2 + START_X, GROUND)
    (vp.select.scriptFor(name1, me.v(142))).install(me)
    (vp.select.scriptFor(name2, me.v(143))).install(foe)
    foe.palette := if^name1 = name2: 1 el^: 0;
    me.enemy := foe
    foe.enemy := me
    demoBrain := vp.cpu.Brain.new(name1, 100)
    brain := vp.cpu.Brain.new(name2, 100)
    campaign := nil^
    selecting := nil^
    matchSeconds := ROUND_SECONDS
    stage := vp.stage.load($"assets/stages/{STAGES[matchStage] ?? "スクール"}")
    flow := vp.round.load(SYSTEM)
    flow.toWin := 2
    scene := nil^
    attractLoaded := true^
    wasTiming := false^
    startRound()
}

# Only real fights and authored demos remain in the converted story routes.
let^queueStory = p^st:vp.story.State {
    let^e = st.current()
    if^e is^nil^ { st.enter("complete") return^ }
    st.loadImage := if^love.math.random(1, 10) = 1: 2 el^: 1;
    let^l = vp.preload.Load.new(if^e.kind = "fight": "match" el^: "story-event";)
    if^e.kind = "fight" {
        st.enemySupport := if^e.name = "ヒルダ": 100 el^: love.math.random(101, 104);
        l.add($"assets/stages/{e.stage}", false^)
        pendingKind := "story-stage"
    else^:
        if^e.name = "ゆい勝ち" {
            l.victory($"assets/demos/{e.name}", me.v(129))
        else^:
            l.add($"assets/demos/{e.name}", false^)
        }
        pendingKind := "story-demo"
    }
    pending := l
    st.enter("loading")
}

let^startStoryBattle = p^st:vp.story.State, e:vp.story.Event {
    me := Fighter.new($"assets/characters/{st.name}", WORLD_W / 2 - START_X, GROUND)
    foe := Fighter.new($"assets/characters/{e.name}", WORLD_W / 2 + START_X, GROUND)
    (vp.select.scriptFor(st.name, me.v(142))).install(me)
    (vp.select.scriptFor(e.name, me.v(143))).install(foe)
    me.palette := st.colour
    foe.palette := vp.select.opponentColour(st.name, st.colour, e.name, if^st.name = e.name: st.colour el^: 0;)
    me.enemy := foe
    foe.enemy := me
    brain := vp.cpu.Brain.new(e.name, e.level)
    matchSeconds := e.seconds
    me.externalIntroPortrait := true^
    foe.externalIntroPortrait := true^
    flow.preparing := false^
    flow.lossWithMark := e.name = "ヒルダ"
    matchIntro := false^
    wasTiming := false^
    st.enter("battle")
    startRound()
    introCatchup := flow.presentationFrames
}

# Load metadata and decode assets without pausing the scene being left.
# Leaving PRACTICE MODE (back to the title, or F8) turns its hitbox display off.
let^leavePractice = p^{
    if^practiceMode { showBoxes := false^ }
    practiceMode := false^
}

let^prepare = p^kind:string^{
    if^kind = "title" { leavePractice() }
    let^l = vp.preload.Load.new(if^kind = "boot": "system" el^: kind;)
    if^kind = "boot" {
        l.add(SYSTEM, false^)
        l.batch.request($"{SYSTEM}/demos.lton", "lton", false^)
        let^dir = "assets/demos/タイトル"
        for^n from^0 to^16 {
            if^n < 2 or^n >= 5 { l.batch.request($"{dir}/images/{n:%04d}.png", "image", false^) }
        }
        l.batch.request($"{dir}/sounds/0001.wav", "stream", false^)
        l.batch.request($"{dir}/images/0004.png", "image", false^)
        l.batch.request($"{dir}/sounds/0002.wav", "sound", false^)
        for^n from^0 to^2 { l.batch.request($"assets/characters/だみー/images/{n:%04d}.png", "image", false^) }
        for^n from^1 to^3 { l.batch.request($"assets/characters/だみー/sounds/{n:%04d}.wav", "sound", false^) }
        l.batch.request("assets/shared/images/14b0d852366fe1b37f61dce36c1e4f482cb96ea1.png", "image", false^)
        l.batch.request("assets/demos/コンテニュー/images/0000.png", "image", false^)
    elseif^kind = "title":
        l.add($"assets/demos/{demos.title}", false^)
    elseif^kind = "select":
        l.batch.request("data/select-palettes.lton", "lton", false^)
        for^phase in^{"main", "support", "ready"} {
            l.batch.request($"locale:select/{phase}", "image", false^)
            l.batch.request($"locale:select/{phase}-hint", "image", false^)
        }
        l.batch.request("locale:select/roulette", "image", false^)
        l.batch.request("locale:select/random-marker", "image", false^)
        l.add("assets/demos/キャラセレ", false^)
        for^name in^vp.select.CHARACTERS {
            l.add($"assets/characters/{name}", true^)
            l.batch.request($"assets/characters/{name}/story.lton", "lton", false^)
        }
        l.add("assets/characters/ヒルダ", true^)
    }
    pending := l
    pendingKind := kind
}

public^let^load = p^{
    reloadPending := false^
    if^vp.settings.fullscreen() { love.window.setFullscreen(true^) }
    vp.media.prepare()
    # Finish incremental cycles before transient battle objects accumulate.
    # Configure before loading so task workers inherit the same pacing.
    # Measured memory and frame-time comparison: TechnicalDocuments/0071.
    let^gc = L^.gc.settings()
    gc.growth := 120
    gc.stepmul := 800
    gc.stepsize := 10
    L^.gc.configure(gc)
    prepare("boot")
}

let^sceneDone = p^{
    if^pending != nil^ { return^ }
    let^sc = scene
    if^!opening and^sc != nil^ {
        storyMode := sc.item = 0
        practiceMode := sc.item = 2
    }
    prepare(if^opening: "title" el^: "select";)
}

let^completeLoad = p^{
    let^l = pending
    if^l is^nil^ or^!l.ready() { return^ }
    let^kind = pendingKind
    let^st = campaign
    let^s = selecting
    if^(kind = "match" or^kind = "match-stage") and^playing is^nil^ and^(s is^nil^ or^!s.done) { return^ }
    # VS starts the match at the presentation's wait for assets, never before:
    # the fighters are hidden until then, and the match then always starts
    # from the same frame (replays, TechnicalDocuments/0155).
    if^kind = "match" and^!flow.waitingForAssets() and^(flow.phase = "start" or^flow.phase = "call") { return^ }
    if^kind = "briefing" and^(s is^nil^ or^!s.done) { return^ }
    if^(kind = "story-demo" or^kind = "story-stage") and^st != nil^ and^st.age < 0.3 and^st.demo is^nil^ { return^ }
    pending := nil^
    clear2()
    upPressed := false^
    downPressed := false^
    leftPressed := false^
    rightPressed := false^
    pressed := 0
    clock := 0
    if^!matchIntro { love.audio.stop() }
    if^kind = "boot" {
        l.batch.arena.attach() # persistent system and opening assets
        hud := vp.hud.load(SYSTEM)
        flow := vp.round.load(SYSTEM)
        demos := vp.title.loadDemos(SYSTEM)
        vp.arena.push("opening")
        scene := vp.title.openingScreen(true^)
        initialized := true^
    elseif^kind = "attract":
        l.batch.arena.attach()
        startAttract()
    elseif^kind = "briefing":
        l.batch.arena.attach()
        selecting := nil^
        if^st != nil^ { st.enter("difficulty") }
    elseif^kind = "match-stage" or^kind = "story-stage":
        l.batch.arena.attach()
        matchArena := l.batch.arena
        let^fighters = vp.preload.Load.new("match-characters")
        if^kind = "match-stage" and^(s != nil^ or^playing != nil^) {
            let^name1 = setup.name1
            let^name2 = setup.name2
            # A replay leaves the mode menu as its presentation starts.
            if^playing != nil^ {
                vp.replaylist.close()
                scene := nil^
            }
            me.setv(140, if^practiceMode: 500 el^: 0;)
            # The two-player select screen leaves V139 at 502. Replays skip
            # select, but stage scripts (notably Last) must see the same mode.
            if^!practiceMode { me.setv(139, 502) }
            beginPresentation(name1, setup.colour1, name2, setup.colour2, STAGES[matchStage] ?? "スクール", vsRoundSeconds())
            fighters.character($"assets/characters/{name1}", me.v(142))
            fighters.character($"assets/characters/{name2}", me.v(143))
            # F3 / F4 may hand either side to the CPU.
            fighters.batch.request($"assets/characters/{name1}/cpu.lton", "lton", false^)
            fighters.batch.request($"assets/characters/{name2}/cpu.lton", "lton", false^)
            pendingKind := "match"
        elseif^st != nil^:
            let^e = st.current()
            if^e is^nil^ { panic^"Missing story match" }
            me.setv(139, 0)
            me.setv(140, (st.difficulty + 1) * 1000)
            me.setv(134, 0)
            me.setv(141, 0)
            me.setv(142, st.support)
            me.setv(143, st.enemySupport)
            beginPresentation(st.name, st.colour, e.name, 0, e.stage, e.seconds)
            flow.toWin := e.rounds
            fighters.character($"assets/characters/{st.name}", st.support)
            fighters.character($"assets/characters/{e.name}", st.enemySupport)
            fighters.batch.request($"assets/characters/{e.name}/cpu.lton", "lton", false^)
            pendingKind := "story-match"
            st.enter("match-intro")
        }
        pending := fighters
    elseif^kind = "story-match" or^kind = "story-demo":
        if^kind = "story-match" {
            let^arena = matchArena
            if^arena is^nil^ { panic^"Missing prepared stage arena" }
            arena.absorb(l.batch.arena)
        else^:
            if^st != nil^ and^st.demo != nil^ {
                let^held : vp.story.State = st
                held.demo := nil^
                vp.arena.pop()      # the ending demo held while this loaded
            }
            l.batch.arena.attach()
        }
        if^st != nil^ {
            let^running : vp.story.State = st
            let^e = running.current()
            if^e != nil^ {
                if^kind = "story-match" { startStoryBattle(running, e)
                else^:
                    running.demo := demos.play(e.name)
                    running.enter("event")
                }
            }
        }
    elseif^kind = "match":
        let^arena = matchArena
        if^arena is^nil^ { panic^"Missing prepared stage arena" }
        arena.absorb(l.batch.arena)
        if^s != nil^ or^playing != nil^ { startBattle() }
    else^:
        vp.arena.pop()
        l.batch.arena.attach()
        if^kind = "title" {
            leavingReplay := false^
            selecting := nil^
            collectSceneGarbage := true^
            opening := false^
            vp.fighter.clearSystemVars()
            let^system = vp.script.load($"{SYSTEM}/script.lton") ?? vp.script.Script.new()
            scene := demos.titleScreen(SYSTEM, system)
        else^:
            scene := nil^
            let^fresh = vp.select.load(SYSTEM, storyMode)
            fresh.solo := practiceMode
            selecting := fresh
        }
    }
}

let^goBack = p^{
    # Loading cannot be cancelled from a menu back input.
    if^pending != nil^ or^matchIntro or^introCatchup > 0 { return^ }
    clear2()
    if^!initialized { love.event.quit() return^ }
    let^sc = scene
    if^sc != nil^ and^sc.customOpening { love.event.quit() return^ }
    if^selecting != nil^ and^selecting.back() { return^ }
    if^netplay { endNet("") return^ }
    let^st = campaign
    if^st != nil^ and^selecting is^nil^ {
        if^st.phase = "battle" or^st.phase = "gameover" or^st.phase = "return-title" { return^ }
        # During a story demo, back is just another button: it skips where
        # the demo allows skipping, and never leaves the story.
        if^st.phase = "event" {
            if^pressed % 2 = 0 { pressed += 1 }
            return^
        }
        if^st.phase = "intro" { st.enter("difficulty") return^ }
        love.audio.stop()
        if^matchArena != nil^ { vp.arena.pop() matchArena := nil^ }
        vp.arena.pop()
        campaign := nil^
        brain := nil^
        matchLoading := false^
        matchIntro := false^
        flow.preparing := false^
        flow.externalPresentation := false^
        releaseBattle()
        selecting := vp.select.load(SYSTEM, true^)
        pressed := 0
        leftPressed := false^
        rightPressed := false^
        upPressed := false^
        downPressed := false^
        return^
    }
    # Battle pause is handled before menu navigation.
    if^sc is^nil^ and^selecting is^nil^{ return^ }
    if^matchArena != nil^ { love.audio.stop() vp.arena.pop() matchArena := nil^ }
    campaign := nil^
    upPressed := false^
    downPressed := false^
    pressed := 0
    clock := 0
    matchLoading := false^
    matchIntro := false^
    flow.preparing := false^
    flow.externalPresentation := false^
    releaseBattle()
    if^selecting != nil^ {
        prepare("title")
    else^:
        love.audio.stop()
        vp.arena.pop()
        vp.fighter.clearSystemVars()
        opening := true^
        vp.arena.push("opening")
        scene := vp.title.openingScreen(false^)
    }
}

# Check before touching the running scene: a rejected edit keeps it playable.
# Unchanged units survive reload, so release their jobs and scene resources.
let^debugReload = p^{
    let^refused = love.event.reload()
    if^refused fits^love.event.Error { print(refused.message) return^ }
    reloadPending := true^
    leavePractice()
    recording := nil^
    playing := nil^
    replaySnapshots := {}
    leavingReplay := false^
    vp.net.leave()
    netplay := false^
    let^l = pending
    if^l != nil^ { l.batch.cancel() pending := nil^ }
    vp.resource.stop()
    love.audio.stop()
    releaseBattle()
    vp.fighter.clearSystemVars()
    vp.arena.popToRoot()
    vp.arena.pop()
    vp.locale.reload()
    vp.input.reload()
    # Also clear references for the remaining frame and for test/tool entries
    # that call this module without being this game's reload root.
    campaign := nil^
    selecting := nil^
    matchArena := nil^
    attract := false^
    attractLoaded := false^
    attractSeconds := 0
    matchLoading := false^
    matchIntro := false^
    introCatchup := 0
    paused := false^
    pendingKind := ""
    clock := 0
    pressed := 0
    upPressed := false^
    downPressed := false^
    leftPressed := false^
    rightPressed := false^
    clear2()
    opening := true^
    scene := nil^
    initialized := false^
}

public^let^quit = p^-> bool^{
    vp.net.leave()
    vp.online.shutdown()
    let^l = pending
    if^l != nil^ { l.batch.cancel() }
    vp.resource.stop()
    return^false^
}

# The running story, for flow tests that start it at a given event.
public^let^story = f^-> vp.story.State|nil^{ campaign }

# Read-only diagnostics for flow regression checks and development tools.
public^let^status = f^{
    let^st = campaign
    let^cpu = brain
    let^sc = scene
    let^firstCPU = demoBrain
    let^support = me.slots[5]
    let^cue = sc?.confirmSound
    var^selectCue = false^
    let^selectDemo = selecting?.demo
    var^nameImage = -1
    for^layer in^hud.layers { if^layer.skillNo = 59 { nameImage := layer.image } }
    if^selectDemo != nil^ {
        for^layer in^selectDemo.layers {
            if^layer.sounds[2] != nil^ or^layer.sounds[3] != nil^ { selectCue := true^ }
        }
    }
    var^duplicatePortraits = 0
    for^p in^{me, foe} {
        if^p.externalIntroPortrait {
            for^o in^p.objects { if^o.onScreen and^o.depth = 117 { duplicatePortraits += 1 } }
        }
    }
    return^{
        duplicatePortraits = duplicatePortraits, introPortraits = flow.portraits.length^, introMusicPlaying = matchIntro and^flow.music != nil^ and^flow.music.isPlaying(),
        selectPhase1 = selecting?.phase(0) ?? "", selectPhase2 = selecting?.phase(1) ?? "",
        phase = if^matchIntro: "match-intro" el^selecting != nil^: "select" el^st != nil^: st.phase el^scene != nil^: "title" el^: "battle";,
        backgroundOnly = flow.backgroundOnly(), presentationFrames = flow.presentationFrames, introCatchup = introCatchup,
        waitingFrames = flow.waitingFrames,
        roundPhase = flow.phase, presentationLeft = flow.left,
        matchMusicPlaying = matchArena != nil^ and^flow.music != nil^ and^flow.music.isPlaying(),
        loading = pending != nil^, loadingKind = pendingKind, stagePrepared = matchArena != nil^ and^stage.layers.length^ > 0,
        story = storyMode, practice = practiceMode, modeVariable = me.v(140), cpuActions = if^cpu != nil^: cpu.actions el^: 0;,
        enemyX = foe.x, playerX = me.x, randomState = vp.rng.get(), enemyLife = foe.life, playerLife = me.life, enemySkill = foe.skillNo,
        paused = paused, practiceMenu = vp.practicemenu.isOpen(), guard = dummyGuard, boxes = showBoxes, roundFrames = roundFrames,
        battleResourcesHeld = me.skills[1] != nil^ or^foe.skills[1] != nil^ or^stage.layers.length^ > 0,
        modeExitFrames = if^sc != nil^: sc.exitFrames el^: -1;,
        modeCuePlaying = cue != nil^ and^cue.isPlaying(), selectCuePlayed = selectCue,
        attract = attract, attractLoaded = attractLoaded, attractSeconds = attractSeconds,
        firstCPUActions = if^firstCPU != nil^: firstCPU.actions el^: 0;,
        playerDir = me.dir, playerCode = me.v(129), enemyCode = me.v(130), playerNameImage = nameImage,
        firstCPULevel = if^firstCPU != nil^: firstCPU.level el^: 0;,
        secondCPULevel = if^cpu != nil^: cpu.level el^: 0;,
        openingAnimated = sc != nil^ and^sc.customOpening and^!sc.titleShown,
        supportSkill = if^support != nil^: support.skillNo el^: -1;,
        wins = flow.wins1, losses = flow.wins2,
        difficulty = if^st != nil^: st.difficulty el^: -1;,
        event = if^st != nil^: st.at el^: -1;,
        recording = recording != nil^, replaying = playing != nil^, replayFrame = replayFrame,
        netplay = netplay, netFrame = netFrame, netRound = netRound, netWaiting = netWaiting,
        netRollbacks = rollback.corrections, netPredicted = rollback.predicted, netSnapshots = rollback.snapshots, netReplayed = rollback.replayed,
        netMaxDepth = rollback.maxDepth, netWaits = rollback.waits,
        netPredictionLimit = ROLLBACK_MAX,
        netDesync = vp.net.desyncFrame(), netChecked = vp.net.sumsChecked(), link = vp.net.status(),
        replayMatched = replayMatched, lastReplay = lastReplay, replaySnapshots = snapshotCount(), fastForward = fastForward, cpuFirst = cpuFirst, cpuSecond = cpuSecond,
    }
}

# VS rounds' length in seconds (tests shorten matches with it).
public^let^setVSSeconds = p^n:number^{ vsSeconds := n }
public^let^setVSSeed = p^n:number^{ vsSeed := n }

# A match's state at a frame (TechnicalDocuments/0156): src/snapshot.lh's
# fighters, round, HUD and stage, and what this file keeps of the match.
public^let^Saved = def^{
    self^{
        abstract^state : vp.snapshot.Snapshot,
        camX = 0, camY = 0, aimX = 0, aimY = 0,
        roundFrames = 0, frame = 0, wasTiming = false^, matchSeconds = 0, replayFrame = 0,
        firstBrain : vp.cpu.Brain|nil^= nil^,
        firstStore : vp.cpu.Brain|nil^= nil^,
        secondBrain : vp.cpu.Brain|nil^= nil^,
        secondStore : vp.cpu.Brain|nil^= nil^,
    },
    override^new = p^state:vp.snapshot.Snapshot{ self^{ state = state } },
}

let^brainStore = p^b:vp.cpu.Brain|nil^, p:Fighter, spare:vp.cpu.Brain|nil^-> vp.cpu.Brain|nil^{
    if^b is^nil^ { return^nil^ }
    let^store = spare ?? vp.cpu.Brain.new(nameOf(p), b.level)
    b.copyStateTo(store)
    return^store
}

# The running match's state, taken between frames. `reuse`, a snapshot no
# longer needed, lends its storage.
public^let^snapshot = p^reuse:Saved|nil^-> Saved {
    let^s = Saved.new(vp.snapshot.take({ me, foe }, flow, hud, stage, reuse?.state))
    s.camX := camX s.camY := camY s.aimX := aimX s.aimY := aimY
    s.roundFrames := roundFrames s.frame := frame s.wasTiming := wasTiming
    s.matchSeconds := matchSeconds s.replayFrame := replayFrame
    s.firstBrain := demoBrain
    s.firstStore := brainStore(demoBrain, me, reuse?.firstStore)
    s.secondBrain := brain
    s.secondStore := brainStore(brain, foe, reuse?.secondStore)
    return^s
}

# Puts the match back as the snapshot found it; the snapshot can be used again.
public^let^restore = p^s:Saved{
    vp.snapshot.restore(s.state)
    camX := s.camX camY := s.camY aimX := s.aimX aimY := s.aimY
    vp.fighter.setView(camX, camY)
    roundFrames := s.roundFrames frame := s.frame wasTiming := s.wasTiming
    matchSeconds := s.matchSeconds replayFrame := s.replayFrame
    vp.fighter.setRound(roundFrames, flow.number)
    demoBrain := s.firstBrain
    let^first = s.firstBrain
    let^firstStore = s.firstStore
    if^first != nil^ and^firstStore != nil^ { firstStore.copyStateTo(first) }
    brain := s.secondBrain
    let^second = s.secondBrain
    let^secondStore = s.secondStore
    if^second != nil^ and^secondStore != nil^ { secondStore.copyStateTo(second) }
}

# The characters' sounds stop (a rewind does not play them backwards).
let^stopFighterSounds = p^{
    for^p in^{ me, foe } {
        for^n, src in^p.sounds { if^src != nil^ { src.stop() } }
        for^path, src in^p.soundsByPath { if^src != nil^ { src.stop() } }
    }
}

let^snapshotCount = f^-> number^{
    var^n = 0
    for^k, v in^replaySnapshots { if^v != nil^ { n += 1 } }
    return^n
}

# Back to the last snapshot at least REWIND_MARGIN frames before now.
let^rewindReplay = p^{
    var^at = ((replayFrame - REWIND_MARGIN) / SNAPSHOT_EVERY).floor() * SNAPSHOT_EVERY
    if^at < 0 { at := 0 }
    repeat^while^at > 0 and^replaySnapshots[at] is^nil^ { at -= SNAPSHOT_EVERY }
    let^s = replaySnapshots[at]
    if^s is^nil^ { return^ }
    stopFighterSounds()
    restore(s)
}

# What the match looks like this frame, to compare two runs of it (tests).
public^let^signature = p^-> string^{
    var^out = $"{frame} {replayFrame} {roundFrames} {flow.phase} {flow.wins1}-{flow.wins2} rng {vp.rng.get()} cam {camX},{camY}"
    for^p in^{ me, foe } {
        out := $"{out} | {p.x},{p.y} {p.life} {p.special} #{p.skillNo} i{p.image} o{p.objects.length^}"
        for^o in^p.objects { out := $"{out} {o.skillNo}:{o.image}@{o.x},{o.y}" }
    }
    return^out
}

# The directions held, as a replay records them: up 1, down 2, left 4, right 8.
let^heldDirs = p^up:love.keyboard.Key, down:love.keyboard.Key, left:love.keyboard.Key, right:love.keyboard.Key-> number^{
    return^(if^vp.input.isDown(up): 1 el^: 0;) + (if^vp.input.isDown(down): 2 el^: 0;) +
        (if^vp.input.isDown(left): 4 el^: 0;) + (if^vp.input.isDown(right): 8 el^: 0;)
}

# VS's CPU (F3 / F4, or the replay's record of them) takes a side over or
# hands it back, as of this frame; a new brain starts as a round's does.
let^syncCPU = p^one:number^, two:number^{
    if^vp.replay.cpuOf(one) {
        if^demoBrain is^nil^ { demoBrain := vp.cpu.Brain.new(nameOf(me), CPU_LEVEL) }
    else^:
        demoBrain := nil^
    }
    if^vp.replay.cpuOf(two) {
        if^brain is^nil^ { brain := vp.cpu.Brain.new(nameOf(foe), CPU_LEVEL) }
    else^:
        brain := nil^
    }
}

# A battle frame, shared by normal play and rollback resimulation.
let^battleStep = p^one:number^, two:number^{
    vp.fighter.setView(camX, camY)
    let^story = campaign
    # Refresh facing before converting physical directions and consuming
    # buffered commands, including the first frame after landing recovery.
    if^flow.fighting() { me.faceOpponent() foe.faceOpponent() }
    # The sides' input this frame: the played replay's, or the keys' and pads'
    # (and F3 / F4's CPU in VS), recorded when VS records.
    let^tape = playing
    if^tape != nil^ and^replayFrame % SNAPSHOT_EVERY = 0 and^replaySnapshots[replayFrame] is^nil^ {
        replaySnapshots[replayFrame] := snapshot(nil^)
    }
    if^tape != nil^ { replayFrame += 1 }
    let^rec = recording
    if^rec != nil^ {
        if^netplay and^netFrame < rec.frames() {
            rec.side1[netFrame] := one
            rec.side2[netFrame] := two
        else^: rec.push(one, two) }
    }
    if^tape != nil^ or^rec != nil^ { syncCPU(one, two) }
    let^dirs1 = vp.replay.dirsOf(one)
    let^dirs2 = vp.replay.dirsOf(two)
    let^right = (dirs1 / 8).floor() % 2 = 1
    let^left = (dirs1 / 4).floor() % 2 = 1
    let^forward = if^me.facing > 0: right el^: left;
    let^back = if^me.facing > 0: left el^: right;
    # Only while they fight does input count.
    let^live = flow.fighting()
    let^firstCPU = demoBrain
    var^firstInput : vp.cpu.Input = {dir = 5, skill = 0, guard = false^, buttons = 0}
    if^firstCPU != nil^ {
        if^live { firstInput := firstCPU.step(me, foe) }
        let^d = firstInput.dir
        control(me, live and^d >= 7, live and^d <= 3, live and^d % 3 = 0, live and^d % 3 = 1, firstInput.buttons, firstCPU)

    else^:
        control(me, live and^dirs1 % 2 = 1, live and^(dirs1 / 2).floor() % 2 = 1, live and^forward, live and^back, if^live: vp.replay.buttonsOf(one) el^: 0;, nil^)
    }
    # Discard menu direction presses during battle so they cannot reach select.
    upPressed := false^
    downPressed := false^
    leftPressed := false^
    rightPressed := false^
    pressed := 0
    let^cpu = brain
    var^cpuInput : vp.cpu.Input = {dir = 5, skill = 0, guard = false^, buttons = 0}
    let^right2 = (dirs2 / 8).floor() % 2 = 1
    let^left2 = (dirs2 / 4).floor() % 2 = 1
    let^forward2 = if^foe.facing > 0: right2 el^: left2;
    let^back2 = if^foe.facing > 0: left2 el^: right2;
    if^cpu != nil^ and^live { cpuInput := cpu.step(foe, me) }
    if^cpu != nil^ {
        let^d = cpuInput.dir
        control(foe, live and^d >= 7, live and^d <= 3, live and^d % 3 = 0, live and^d % 3 = 1, cpuInput.buttons, cpu)

    else^:
        control(foe, live and^dirs2 % 2 = 1, live and^((dirs2 / 2).floor() % 2 = 1 or^dummyGuard = 3), live and^forward2, live and^back2, if^live: vp.replay.buttonsOf(two) el^: 0;, nil^)
    }
    clear2()

    # Holding back works both while free and throughout a guard reaction.
    # The dummy guards while `dummyGuard` is on: crouching for 3, and for 1 in
    # whichever posture guards each attack.
    let^free = f^p:Fighter-> bool^{ return^groundIdle(p.skillNo) or^airIdle(p.skillNo) }
    me.updateGuard(live and^(if^firstCPU != nil^: firstInput.guard el^: back;), me.inputDirection() <= 3, free(me))
    foe.guardEither := cpu is^nil^ and^dummyGuard = 1
    foe.updateGuard(live and^(if^cpu != nil^: cpuInput.guard el^: back2 or^dummyGuard > 0;), foe.inputDirection() <= 3, free(foe))

    # The clock runs while they fight and the timer shows (system variable
    # 128, which FIGHT clears a couple of frames after its show time).
    let^timing = live and^me.v(128) <= 9999
    if^timing and^roundFrames > 0 and^matchSeconds > 0 { roundFrames -= 1 }
    vp.fighter.setRound(roundFrames, flow.number)
    flow.step(me, foe, roundFrames <= 0, startRound, p^{
        if^netplay { rollback.ending := true^ else^: toSelect() }
    })
    if^netplay and^rollback.ending {
        netFrame += 1
        rollback.sums[netFrame] := nil^
        return^
    }
    if^scene != nil^ or^selecting != nil^ or^(story != nil^ and^story.phase != "battle") { return^ }
    vp.shake.horizontal.step()
    vp.shake.vertical.step()
    stage.step()
    if^timing and^!wasTiming { hud.fightBegins() }
    wasTiming := timing
    # The digits follow the round time the scripts read (59 through the
    # start, hidden then; layout 5 shows "60").
    hud.step(me, foe, if^matchSeconds = 0: -1 el^: (std.math.max(roundFrames - 1, 0) / 100).floor();)
    stepFighters()

    frame += 1
    if^netplay {
        netFrame += 1
        if^netFrame % vp.net.SUM_EVERY = 0 {
            rollback.sums[netFrame] := { match = netRound, frame = netFrame, random = vp.rng.get(), life1 = me.life, life2 = foe.life, x1 = me.x.floor(), x2 = foe.x.floor() }
        }
    }
    if^!rollback.resimulating and^me.skillName != lastSkill {
        print($"{frame}: {me.skillName}  x={me.x:%.0f} y={me.y:%.0f} facing={me.facing}")
        lastSkill := me.skillName
    }
}

# Keep only a confirmed checkpoint, and only while there is speculation.
let^netCheckpoint = p^{
    rollback.saved := snapshot(rollback.spare)
    rollback.spare := rollback.saved
    rollback.base := netFrame
    rollback.snapshots += 1
}

let^netStep = p^{
    let^known = vp.net.remote(netFrame)
    let^other = known ?? rollback.used[netFrame - 1] ?? 0
    rollback.used[netFrame] := other
    let^own = vp.net.localInput(netFrame)
    if^vp.net.localSide() = 0 { battleStep(own, other) else^: battleStep(other, own) }
}

let^netTick = p^{
    let^ahead = netFrame + vp.net.INPUT_DELAY
    if^vp.net.sampled() < ahead {
        vp.net.sample(ahead, vp.replay.pack(heldDirs(Key.up, Key.down, Key.left, Key.right), vp.input.heldButtons(0), cpuFirst))
    }
    let^confirmed = vp.net.confirmed()
    let^saved = rollback.saved
    if^saved != nil^ {
        let^target = netFrame
        var^wrong = false^
        for^f from^rollback.base to^std.math.min(target, confirmed) - 1 {
            if^rollback.used[f] != vp.net.remote(f) { wrong := true^ break^ }
        }
        # A matching prediction needs no replay. Rebase only when the
        # prediction window fills, or when a correction is necessary.
        if^wrong or^(target - rollback.base >= ROLLBACK_MAX and^confirmed > rollback.base and^confirmed < target) {
            if^wrong { rollback.corrections += 1 }
            restore(saved)
            netFrame := rollback.base
            rollback.ending := false^
            rollback.resimulating := true^
            vp.fighter.setResimulating(true^)
            repeat^while^netFrame < target and^!rollback.ending {
                netStep()
                rollback.replayed += 1
                if^netFrame = confirmed and^netFrame < target and^!rollback.ending { netCheckpoint() }
            }
            vp.fighter.setResimulating(false^)
            rollback.resimulating := false^
        }
        if^confirmed >= netFrame and^(!vp.net.isOnline() or^vp.net.peerConfirmed() >= netFrame) { rollback.saved := nil^ }
    }
    # Publish only confirmed states; speculative summaries are overwritten
    # during correction before they can be compared with the peer's.
    repeat^while^rollback.sentSum + vp.net.SUM_EVERY <= std.math.min(netFrame, confirmed) {
        rollback.sentSum += vp.net.SUM_EVERY
        let^sum = rollback.sums[rollback.sentSum]
        if^sum != nil^ { vp.net.summarize(sum) rollback.sums[rollback.sentSum] := nil^ }
    }
    if^rollback.ending {
        if^confirmed >= netFrame {
            let^rec = recording
            if^rec != nil^ {
                rec.side1 := rec.side1.slice^(0, netFrame - 1)
                rec.side2 := rec.side2.slice^(0, netFrame - 1)
            }
            rollback.saved := nil^
            rollback.spare := nil^
            toSelect()
        }
        return^
    }
    if^rollback.saved != nil^ and^netFrame - rollback.base >= ROLLBACK_MAX {
        netWaiting += 1
        rollback.waits += 1
        return^
    }
    if^vp.net.remote(netFrame) is^nil^ {
        if^rollback.saved is^nil^ { netCheckpoint() }
        rollback.predicted += 1
    }
    netWaiting := 0
    netStep()
    if^rollback.saved != nil^ { rollback.maxDepth := std.math.max(rollback.maxDepth, netFrame - rollback.base) }
}

let^tick = p^{
    if^leavingReplay { return^ }
    let^sc = scene
    if^sc != nil^ {
        sc.step(upPressed, downPressed, pressed)
        upPressed := false^
        downPressed := false^
        pressed := 0
        let^choice = vp.replaylist.takeChoice()
        if^choice != "" and^pending is^nil^ { startReplay(choice) }
        if^vp.lanmenu.linked() and^pending is^nil^ { startNetSelect() }
        if^sc.done { sceneDone() }
        return^
    }
    if^matchIntro {
        vp.fighter.setView(camX, camY)
        let^before = flow.presentationFrames
        flow.step(me, foe, false^, p^{}, p^{})
        if^flow.presentationFrames != before { stage.step() }
        clear2()
        return^
    }
    let^s = selecting
    if^s != nil^ {
        let^dx = if^rightPressed or^vp.input.isDown(Key.right): 1 el^leftPressed or^vp.input.isDown(Key.left): -1 el^: 0;
        let^dy = if^vp.input.isDown(Key.up): 1 el^vp.input.isDown(Key.down): -1 el^: 0;
        let^dx2 = if^rightPressed2 or^vp.input.isDown(Key.k): 1 el^leftPressed2 or^vp.input.isDown(Key.h): -1 el^: 0;
        let^dy2 = if^vp.input.isDown(Key.u): 1 el^vp.input.isDown(Key.j): -1 el^: 0;
        if^netplay {
            # This machine's 1P keys play its own side; the other side only
            # takes the choice it confirmed over there.
            let^local = vp.net.localSide()
            let^remote = 1 - local
            if^local = 0 {
                s.step(upPressed, downPressed, 5 + dx + 3 * dy, pressed, false^, false^, 5, 0)
            else^:
                s.step(false^, false^, 5, 0, upPressed, downPressed, 5 + dx + 3 * dy, pressed)
            }
            let^mine = s.sides[local]
            if^mine != nil^ {
                vp.net.choose({ match = netRound, confirmed = mine.confirmed, row = mine.row, colour = mine.colour, support = mine.support })
            }
            let^c = vp.net.theirChoice()
            if^c.match = netRound and^c.confirmed { s.applyChoice(remote, c.row, c.colour, c.support) }
        else^:
            s.step(upPressed, downPressed, 5 + dx + 3 * dy, pressed, upPressed2, downPressed2, 5 + dx2 + 3 * dy2, pressed2)
        }
        leftPressed := false^
        rightPressed := false^
        clear2()
        upPressed := false^
        downPressed := false^
        pressed := 0
        let^canLoad = if^s.story: s.bothChosen() and^s.wait >= LOAD_DELAY el^: s.done;
        # A LAN guest loads the match the host set up for this round.
        let^setUp = !netplay or^vp.net.hosting() or^vp.net.hostSetup().match = netRound
        if^canLoad and^setUp and^!matchLoading and^pending is^nil^ { loadMatch(s) }
        # The completed match continues the already-running VS presentation.
        return^
    }
    let^story = campaign
    if^story != nil^ and^story.phase != "battle" { return^ }
    if^netplay { netTick() return^ }
    let^tape = playing
    var^one = 0
    var^two = 0
    if^tape != nil^ {
        one := tape.side1[replayFrame] ?? 0
        two := tape.side2[replayFrame] ?? 0
        # battleStep takes the checkpoint before advancing the replay frame.
    else^:
        let^vs = recording != nil^
        one := vp.replay.pack(heldDirs(Key.up, Key.down, Key.left, Key.right), vp.input.heldButtons(0), vs and^cpuFirst)
        two := vp.replay.pack(heldDirs(Key.u, Key.j, Key.h, Key.k), vp.input.heldButtons(1), vs and^cpuSecond)
    }
    battleStep(one, two)
}

public^let^update = p^dt:number^{
    if^reloadPending { return^ }
    # Run after the retiring scene's call stack has unwound. Automatic GC
    # otherwise keeps large, discarded skill graphs across opening loops.
    if^collectSceneGarbage {
        collectSceneGarbage := false^
        L^.gc.collect()
    }
    for^key in^vp.input.poll() { logicalKeypressed(key, false^) }
    vp.net.poll()
    if^netplay and^!vp.net.active() { endNet(vp.net.problemText()) }
    # The host stops the pool at the reload boundary. Do not start it again
    # in this retiring frame, leaving resource.started out of sync.
    if^reloadPending or^paused { return^ }
    vp.resource.pump(LOAD_SLICE)
    completeLoad()
    if^pending != nil^ or^scene != nil^ or^(campaign != nil^ and^selecting is^nil^) { clear2() }
    if^!initialized { return^ }
    if^introCatchup > 0 {
        clock += dt
        if^clock > 2 * FRAME { clock := 2 * FRAME }
        repeat^while^clock >= FRAME {
            clock -= FRAME
            flow.animateWaitingPortraits()
        }
        # Bound catch-up work to keep rendering responsive after a slow load.
        let^until = love.timer.getTime() + 0.002
        repeat^while^introCatchup > 0 and^love.timer.getTime() < until {
            stepFighters()
            hud.step(me, foe, if^matchSeconds = 0: -1 el^: matchSeconds;)
            introCatchup -= 1
        }
        return^
    }
    if^attractLoaded {
        attractSeconds += dt
        if^attractSeconds >= 60 { endAttract(true^) return^ }
    }
    let^st = campaign
    if^st != nil^ and^selecting is^nil^ and^st.phase != "battle" and^!matchIntro {
        let^running : vp.story.State = st
        running.step(dt, leftPressed or^(running.phase = "continue" and^upPressed), rightPressed or^(running.phase = "continue" and^downPressed), pressed)
        if^running.phase = "event" {
            let^demo = running.demo
            clock += dt
            if^clock > 2 * FRAME { clock := 2 * FRAME }
            repeat^while^clock >= FRAME {
                clock -= FRAME
                if^demo != nil^ { demo.step(false^, false^, pressed) }
                pressed := 0
            }
            if^demo != nil^ and^demo.done {
                love.audio.stop()
                running.advance()
                # Between ending demos the finished one stays on screen until
                # the next is loaded; completeLoad pops it then.
                let^next = running.current()
                if^!running.ending or^next is^nil^ or^next.kind != "demo" {
                    running.demo := nil^
                    vp.arena.pop()
                }
            }
        }
        if^running.phase = "queue" and^pending is^nil^ { queueStory(running) }
        if^running.phase = "complete" or^running.phase = "return-title" {
            love.audio.stop()
            vp.arena.pop()          # story introduction
            vp.arena.pop()          # character select
            campaign := nil^
            brain := nil^
            matchLoading := false^
            selecting := nil^
            releaseBattle()
            vp.fighter.clearSystemVars()
            opening := true^
            clock := 0
            vp.arena.push("opening")
            scene := vp.title.openingScreen(false^)
        }
        upPressed := false^
        downPressed := false^
        leftPressed := false^
        rightPressed := false^
        pressed := 0
        return^
    }
    if^pending != nil^ {
        upPressed := false^
        downPressed := false^
        pressed := 0
    }
    let^sc = scene
    if^sc != nil^ and^sc.customOpening {
        sc.updateOpening(dt, pressed)
        upPressed := false^
        downPressed := false^
        pressed := 0
        clock := 0
        if^sc.done { sceneDone()
        elseif^sc.attractReady and^pending is^nil^: queueAttract() }
        return^
    }
    # A played replay: left steps back to a snapshot (again while held),
    # right holds fast forward.
    let^watching = playing != nil^ and^inBattle()
    fastForward := watching and^vp.input.isDown(Key.right)
    if^watching and^vp.input.isDown(Key.left) {
        rewindTimer -= dt
        if^rewindTimer <= 0 {
            rewindReplay()
            rewindTimer := REWIND_REPEAT
        }
    else^:
        rewindTimer := 0
    }
    clock += dt
    # At most two frames of catching up after a slow frame: the game slows
    # down instead of skipping what it did not show.
    if^clock > 2 * FRAME { clock := 2 * FRAME }
    repeat^while^clock >= FRAME {
        clock -= FRAME
        for^i from^1 to^(if^fastForward: FAST_FORWARD el^: 1;) {
            if^i = 1 or^(playing != nil^ and^inBattle()) { tick() }
        }
    }
}

# A plain life bar, 500 px wide; the dummy's drains from the other end.
let^lifeBar = p^p:Fighter, x:number^, y:number^, mirrored:bool^{
    let^w = 500 * p.life / p.lifeMax
    love.graphics.setColor(0.2, 0.2, 0.2, 0.8)
    love.graphics.rectangle(love.graphics.DrawMode.fill, x, y, 500, 16)
    love.graphics.setColor(1, 0.85, 0.2, 1)
    love.graphics.rectangle(love.graphics.DrawMode.fill, if^mirrored: x el^: x + 500 - w;, y, w, 16)
    love.graphics.setColor(1, 1, 1, 1)
}

let^cross = p^p:Fighter{
    love.graphics.setColor(1, 1, 0, 1)
    love.graphics.line(p.x - 8, p.y, p.x + 8, p.y)
    love.graphics.line(p.x, p.y - 8, p.x, p.y + 8)
}

# Debugging text, outlined in black so it reads over bright scenes too, in
# a font with Japanese (LÖVE's default has none; the default is kept when
# the font is missing).
var^debugFont : love.graphics.Font|nil^= nil^
var^debugFontTried = false^

let^debugText = p^text:string^, x:number^, y:number^{
    # Debug overlays and their large font are only used by source runs.
    if^love.filesystem.isFused() { return^ }
    if^!debugFontTried {
        debugFontTried := true^
        let^f = love.graphics.newFont("data/NotoSansMonoCJKjp-Regular.otf", 13) catch^nil^
        if^f fits^love.graphics.Font { debugFont := f }
    }
    let^font = debugFont
    if^font != nil^ { love.graphics.setFont(font) }
    love.graphics.setColor(0, 0, 0, 1)
    for^dx from^-1 to^1 {
        for^dy from^-1 to^1 {
            if^dx != 0 or^dy != 0 { love.graphics.print(text, x + dx, y + dy) }
        }
    }
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.print(text, x, y)
}

let^drawScene = p^{
    if^paused and^!(practiceMode and^vp.practicemenu.isOpen()) {
        let^tex = vp.arena.texture($"{SYSTEM}/images/0165.png")
        if^tex != nil^ {
            love.graphics.setColor(1, 1, 1, 1)
            love.graphics.draw(tex, 0, 0, 0, WINDOW_W / 640, WINDOW_H / 480)
        }
        return^
    }
    if^!initialized {
        love.graphics.setColor(1, 1, 1, 1)
        love.graphics.print("Loading...", 24, 24)
        return^
    }
    let^st = campaign
    if^st != nil^ and^selecting is^nil^ and^st.phase != "battle" and^!matchIntro {
        love.graphics.push()
        love.graphics.scale(SCALE)
        let^demo = st.demo
        if^demo != nil^ { demo.draw()
        else^: st.draw() }
        love.graphics.pop()
        return^
    }
    let^sc = scene
    if^sc != nil^ {
        love.graphics.push()
        love.graphics.scale(SCALE)
        sc.draw()
        love.graphics.pop()
        return^
    }
    if^matchIntro or^flow.backgroundOnly() {
        love.graphics.push()
        love.graphics.scale(SCALE)
        love.graphics.translate(-camX, -camY)
        stage.draw(camX, camY, 0, stage.layers.length^)
        love.graphics.translate(camX, camY)
        vp.fighter.setView(0, 0)
        let^items = flow.items()
        vp.round.byDepth(items)
        for^i in^items { i.draw() }
        love.graphics.pop()
        return^
    }
    let^s = selecting
    if^s != nil^ {
        love.graphics.push()
        love.graphics.scale(SCALE)
        s.draw()
        love.graphics.pop()
        let^stageName = if^stageChoice > 0: STAGES[stageChoice - 1] ?? "" el^: "random";
        debugText($"t stage: {stageName}", 16, 16)
        return^
    }
    love.graphics.push()
    love.graphics.scale(SCALE)
    love.graphics.translate(-camX + vp.shake.horizontal.offset, -camY + vp.shake.vertical.offset)
    love.graphics.setColor(1, 1, 1, 1)
    vp.fighter.setView(camX, camY)
    stage.draw(camX, camY, 0, stage.players)
    # The round's things below the characters (KO's burst of light at 50
    # replaces the stage's back layers, 12, behind the fighters and the
    # stage's front, 100) and those between the fighters and the front.
    let^roundItems = flow.items()
    vp.round.byDepth(roundItems)
    let^roundBetween = p^from:number^, to:number^{
        love.graphics.push()
        love.graphics.translate(camX - vp.shake.horizontal.offset, camY - vp.shake.vertical.offset)
        for^i in^roundItems {
            if^i.depth >= from and^i.depth < to { i.draw() }
        }
        love.graphics.pop()
    }
    roundBetween(0, 70)
    foe.drawObjects(false^)
    me.drawObjects(false^)
    if^foe.depth <= me.depth { foe.draw() me.draw() else^: me.draw() foe.draw() }
    foe.drawObjects(true^)
    me.drawObjects(true^)
    roundBetween(70, 100)
    if^showBoxes {
        foe.drawBoxes()
        me.drawBoxes()
        cross(foe)
        cross(me)
    }
    stage.draw(camX, camY, stage.players, stage.layers.length^)
    love.graphics.pop()
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.push()
    love.graphics.scale(SCALE)
    # In view coordinates, by depth: the HUD (100), the characters' screen
    # objects in front of them (their part of the HUD, cut-ins) and the
    # round's from 100 on (VS screen, READY / FIGHT, KO, victory marks).
    var^list : t^{vp.round.Item[]} = {}
    for^i in^roundItems {
        if^i.depth >= 100 { list.push^(i) }
    }
    list.push^(vp.round.Item.new())          # f nil^: the system HUD
    let^last = list[list.length^ - 1]
    if^last != nil^ { last.depth := 100 }
    for^p in^{ foe, me } {
        for^o in^p.objects {
            if^o.onScreen and^o.depth > 80 {
                let^i = vp.round.Item.new()
                i.depth := o.depth
                i.f := o
                list.push^(i)
            }
        }
    }
    vp.round.byDepth(list)
    vp.fighter.setView(0, 0)
    for^i in^list {
        if^i.f is^nil^ {
            hud.draw(me, foe)
        elseif^i.world:
            love.graphics.push()
            love.graphics.translate(-camX + vp.shake.horizontal.offset, -camY + vp.shake.vertical.offset)
            i.draw()
            love.graphics.pop()
        else^:
            love.graphics.push()
            let^object = i.f
            if^!object.system { love.graphics.translate(vp.shake.horizontal.offset, vp.shake.vertical.offset) }
            i.draw()
            love.graphics.pop()
        }
    }
    vp.fighter.setView(camX, camY)
    if^attractLoaded and^(attractSeconds / 0.25).floor() % 2 = 0 {
        let^prompt = vp.arena.texture("assets/demos/タイトル/images/0001.png")
        if^prompt != nil^ {
            love.graphics.setBlendMode(love.graphics.BlendMode.subtract)
            love.graphics.setColor(1, 1, 1, 1)
            love.graphics.draw(prompt, 171, 421)
            love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
        }
    }
    love.graphics.pop()
    debugText($"{me.skillName}  image {me.image}  palette {me.palette + 1}  fps {love.timer.getFPS()}", 16, 16)
    debugText($"arrows move  z x c a s d = A-F  F1 boxes  1-8 palette  F2 opponent at 1  g dummy guard: {GUARD_NAMES[dummyGuard] ?? ""}", 16, 36)
}

public^let^draw = p^{
    if^reloadPending { return^ }
    let^w, h = love.graphics.getDimensions()
    let^k = std.math.min(w / WINDOW_W, h / WINDOW_H)
    let^ox = ((w - WINDOW_W * k) / 2).floor()
    let^oy = ((h - WINDOW_H * k) / 2).floor()
    love.graphics.push()
    love.graphics.translate(ox, oy)
    love.graphics.scale(k)
    drawGame()
    love.graphics.pop()
    # The bars: what the scaled game leaves of the window.
    love.graphics.setColor(0, 0, 0, 1)
    if^ox > 0 {
        love.graphics.rectangle(love.graphics.DrawMode.fill, 0, 0, ox, h)
        love.graphics.rectangle(love.graphics.DrawMode.fill, w - ox - 1, 0, ox + 1, h)
    }
    if^oy > 0 {
        love.graphics.rectangle(love.graphics.DrawMode.fill, 0, 0, w, oy)
        love.graphics.rectangle(love.graphics.DrawMode.fill, 0, h - oy - 1, w, oy + 1)
    }
    love.graphics.setColor(1, 1, 1, 1)
}

# LAN VS: "choosing" over the other side's portrait until its choice
# arrives, and "waiting" when its input is late.
let^drawNet = p^{
    if^!netplay { return^ }
    var^font = netFont
    if^font is^nil^ {
        let^f = love.graphics.newFont("data/NotoSansMonoCJKjp-Regular.otf", 24) catch^nil^
        font := if^f fits^love.graphics.Font: f el^: love.graphics.newFont(24);
        netFont := font
    }
    let^previous = love.graphics.getFont()
    if^font != nil^ { love.graphics.setFont(font) }
    let^ja = vp.locale.locale() = "ja"
    let^s = selecting
    if^s != nil^ {
        let^remote = 1 - vp.net.localSide()
        let^side = s.sides[remote]
        if^side != nil^ and^!side.confirmed {
            let^x = if^remote = 0: 60 el^: WINDOW_W - 300;
            love.graphics.setColor(0, 0, 0, 0.6)
            love.graphics.rectangle(love.graphics.DrawMode.fill, x - 12, 700, 264, 44)
            love.graphics.setColor(1, 1, 1, 1)
            love.graphics.print(if^ja: "選択中…" el^: "Choosing...";, x, 708)
        }
    }
    if^inBattle() and^netWaiting > 30 {
        love.graphics.setColor(0, 0, 0, 0.6)
        love.graphics.rectangle(love.graphics.DrawMode.fill, 0, 440, WINDOW_W, 60)
        love.graphics.setColor(1, 1, 1, 1)
        love.graphics.print(if^ja: "相手を待っています…" el^: "Waiting for the other side...";, 40, 452)
    }
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.setFont(previous)
}

# A played replay's state, along the bottom of the window.
let^drawReplayBar = p^{
    let^tape = playing
    if^tape is^nil^ or^!inBattle() { return^ }
    let^seconds = (replayFrame / 100).floor()
    let^total = (tape.frames() / 100).floor()
    let^mode = if^fastForward: ">> x4" el^vp.input.isDown(Key.left): "<<" el^: ">";
    let^text = $"REPLAY  {mode}  {(seconds / 60).floor()}:{seconds % 60:%02d} / {(total / 60).floor()}:{total % 60:%02d}    LEFT: rewind   RIGHT: fast forward   ESC: stop"
    love.graphics.setColor(0, 0, 0, 0.6)
    love.graphics.rectangle(love.graphics.DrawMode.fill, 0, WINDOW_H - 28, WINDOW_W, 28)
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.print(text, 12, WINDOW_H - 22)
}

let^drawGame = p^{
    drawScene()
    drawReplayBar()
    if^paused { vp.practicemenu.draw(dummyGuard, showBoxes) }
    if^scene != nil^ { vp.replaylist.draw() vp.lanmenu.draw() }
    drawNet()
    # What the pending load is reading (source runs only, like other debug text).
    if^pending != nil^ {
        let^paths, waiting = vp.resource.progress()
        let^h = WINDOW_H
        let^what = if^paths.length^ = 0: "  (preparing)" el^: "";
        debugText($"loading {pendingKind}: {paths.length^} in flight, {waiting} waiting{what}", 16, h - 32)
        for^path in^paths { debugText(path, 16, h - 52 - 18 * index^) }
    }
}

# The palette keys 1-8.
let^PALETTE_KEYS : t^{love.keyboard.Key[]} = {
    Key.digit1, Key.digit2, Key.digit3, Key.digit4, Key.digit5, Key.digit6, Key.digit7, Key.digit8,
}

# A keyboard and pad pressing the same button must not become another bit.
let^addButton = f^mask:number^, bit:number^-> number^{
    return^if^(mask / bit).floor() % 2 = 0: mask + bit el^: mask;
}

public^let^textinput = p^text:string^{ vp.lanmenu.textinput(text) }

public^let^keypressed = p^key:love.keyboard.Key, scancode:love.keyboard.Scancode, isrepeat:bool^{
    # Text forms consume physical keys before game bindings are translated.
    if^scene != nil^ and^vp.roommenu.editing() and^vp.lanmenu.keypressed(key) { return^ }
    for^logical in^vp.input.translate(key) { logicalKeypressed(logical, isrepeat) }
}

let^logicalKeypressed = p^key:love.keyboard.Key, isrepeat:bool^{
    if^scene != nil^ and^vp.lanmenu.keypressed(key) { return^ }
    # Alt+Enter: fullscreen (a borderless window over the desktop) or not,
    # kept in settings.json. The Enter is not Start.
    if^key = Key.return and^(love.keyboard.isDown(Key.lalt) or^love.keyboard.isDown(Key.ralt)) {
        if^!isrepeat {
            let^on = !vp.settings.fullscreen()
            love.window.setFullscreen(on)
            vp.settings.setFullscreen(on)
        }
        return^
    }
    if^key = Key.f8 { if^!isrepeat { debugReload() } return^ }
    if^attract {
        let^action = key = Key.z or^key = Key.x or^key = Key.c or^key = Key.a or^key = Key.s or^key = Key.d or^
            key = Key.l or^key = Key.semicolon or^key = Key.quote or^key = Key.o or^key = Key.p or^key = Key.leftbracket or^key = Key.return
        if^!isrepeat and^action { endAttract(false^) prepare("title") }
        return^
    }
    let^openingScene = scene
    if^!isrepeat and^openingScene != nil^ and^openingScene.customOpening { openingScene.idleSeconds := 0 }
    # Gamepad Start is mapped to Return by vp.input.
    # Practice pauses into its menu (the guard setting, hitboxes, resume, back to the
    # select screen) instead of the pause image.
    if^practiceMode and^inBattle() {
        # A menu left open by a way out of the match (F8) is not open now.
        if^!paused { vp.practicemenu.close() }
        if^vp.practicemenu.isOpen() {
            if^!isrepeat {
                let^action, guard, boxes = vp.practicemenu.key(key, dummyGuard, showBoxes)
                dummyGuard := guard
                showBoxes := boxes
                if^action = "resume" {
                    vp.practicemenu.close()
                    togglePause()
                elseif^action = "select":
                    vp.practicemenu.close()
                    paused := false^
                    toSelect()
                }
            }
            return^
        }
        if^key = Key.escape or^key = Key.return {
            if^!isrepeat {
                togglePause()
                vp.practicemenu.open()
            }
            return^
        }
    }
    # A LAN match does not pause; ESC leaves the session.
    if^netplay and^inBattle() and^(key = Key.escape or^key = Key.return) {
        if^!isrepeat and^key = Key.escape { endNet("") }
        return^
    }
    # ESC stops a played replay; Start still pauses it.
    if^key = Key.escape and^playing != nil^ and^inBattle() {
        if^!isrepeat and^!paused { endReplay(false^) }
        return^
    }
    if^(key = Key.escape or^key = Key.return) and^inBattle() {
        if^!isrepeat { togglePause() }
        return^
    }
    if^paused { return^ }
    if^key = Key.escape {
        # ESC closes the mode menu's replay list (or steps back in the LAN
        # menu) rather than leaving the menu.
        if^!isrepeat {
            if^scene != nil^ and^vp.replaylist.isOpen() {
                vp.replaylist.close()
            elseif^scene != nil^ and^vp.lanmenu.isOpen():
                vp.lanmenu.back()
            else^:
                goBack()
            }
        }
        return^
    }
    if^!isrepeat and^key = Key.up { upPressed := true^ }
    if^!isrepeat and^key = Key.down { downPressed := true^ }
    if^!isrepeat and^key = Key.left { leftPressed := true^ }
    if^!isrepeat and^key = Key.right { rightPressed := true^ }
    if^!isrepeat {
        if^key = Key.z { pressed := addButton(pressed, 1) }
        if^key = Key.x { pressed := addButton(pressed, 2) }
        if^key = Key.c { pressed := addButton(pressed, 4) }
        if^key = Key.a { pressed := addButton(pressed, 8) }
        if^key = Key.s { pressed := addButton(pressed, 16) }
        if^key = Key.d { pressed := addButton(pressed, 32) }
        if^key = Key.h { leftPressed2 := true^ }
        if^key = Key.k { rightPressed2 := true^ }
        if^key = Key.u { upPressed2 := true^ }
        if^key = Key.j { downPressed2 := true^ }
        if^key = Key.l { pressed2 := addButton(pressed2, 1) }
        if^key = Key.semicolon { pressed2 := addButton(pressed2, 2) }
        if^key = Key.quote { pressed2 := addButton(pressed2, 4) }
        if^key = Key.o { pressed2 := addButton(pressed2, 8) }
        if^key = Key.p { pressed2 := addButton(pressed2, 16) }
        if^key = Key.leftbracket { pressed2 := addButton(pressed2, 32) }
        if^key = Key.return and^(scene != nil^ or^selecting != nil^ or^(campaign != nil^ and^!flow.fighting())) { pressed := addButton(pressed, 1) }
    }
    if^key = Key.f1 { showBoxes := !showBoxes }
    if^key = Key.g { dummyGuard := (dummyGuard + 1) % vp.practicemenu.GUARDS }
    if^key = Key.f2 { foe.life := 1 }
    if^key = Key.t and^selecting != nil^ { stageChoice := (stageChoice + 1) % (STAGES.length^ + 1) }        # the next hit is a KO (for trying the round flow)
    if^key = Key.f5 {
        soundLog := !soundLog
        vp.fighter.setSoundLog(soundLog)
    }
    # VS only (development): the CPU drives 1P / 2P, from the next frame.
    if^!isrepeat and^!storyMode and^!practiceMode and^campaign is^nil^ and^playing is^nil^ {
        if^key = Key.f3 {
            cpuFirst := !cpuFirst
            let^who = if^cpuFirst: "CPU" el^: "player";
            print($"1P: {who}")
        }
        if^key = Key.f4 and^!netplay {
            cpuSecond := !cpuSecond
            let^who = if^cpuSecond: "CPU" el^: "player";
            print($"2P: {who}")
        }
    }
    if^!love.filesystem.isFused() {
        for^v in^PALETTE_KEYS {
            if^key = v { me.palette := index^ }
        }
    }
}
