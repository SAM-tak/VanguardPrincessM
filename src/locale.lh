# Localized images: in a locale other than the original's, an image file may
# be replaced by text drawn with a font (data/locale/<locale>/images.lton,
# keyed by the file's path). The text is drawn once into a canvas that takes
# the file's place, so everything that draws the image (I blocks, blends,
# COLOR tints, the HUD) goes on unchanged. The original locale, "ja", has a
# table only for the port's own changes (its new menu item, reworded
# captions). A key need not be a file: "locale:..." names text the original
# never had, which the game draws through vp.arena.texture like any image.
#
# An entry: size = { w, h } (the canvas), rect = { x, y, w, h } (where the
# text is set; the whole canvas by default), align "left" / "center" /
# "right", valign "top" / "middle" / "bottom", offset = { x, y } (added where
# the image is drawn, for a canvas larger than the original), and the text:
# text = "..." or runs = { { text = "...", fontSize = n, color = {...} }, ... }
# set on one line, bottoms aligned, shrunk to fit the rect's width; or
# lines = { <a text or runs line>, ... } stacked (leading = n pixels between),
# each aligned and shrunk on its own (a line's indent = n puts it n pixels
# in). Each run is filled in its own colour. underline = true^ rules a line
# under the block. font (a file; LOVE's default when
# absent), fontSize, color = { r, g, b }, outline = { color = { r, g, b },
# width = n } are defaults for the runs, and a run may name its own font.
# weight = n (1 by default) thickens the fill of thin strokes; stretch = n
# widens the letters, skew = n slants them.
# wrap = true^ breaks each line between words to the rect's width.
module^vp.locale

import^love.graphics
import^love.filesystem
import^std.lton
import^std.math

public^let^ORIGINAL = "ja"

var^current = ""
var^entries : t^{[string^]:any^} = {}
var^loaded = false^

# The locale: the first line of locale.txt in the save directory (or the
# game's), else the original's.
public^let^locale = p^-> string^{
    if^current = "" {
        let^text = love.filesystem.read("locale.txt") catch^nil^
        var^name = ORIGINAL
        if^text fits^string^ {
            let^line = ((text.split("\n")[0] ?? "").split("\r")[0] ?? "").split(" ")[0] ?? ""
            if^line != "" { name := line }
        }
        current := name
    }
    return^current
}

# A broken table would otherwise silently leave every image as it is.
let^readEntries = p^path:string^-> t^{[string^]:any^}{
    let^raw = try^std.lton.load(path)
    if^raw fits^t^{[string^]:any^} { return^raw }
    return^{}
catch^:
    print($"Localized images not read: {it^.message}")
    return^{}
}

let^load = p^{
    if^loaded { return^}
    loaded := true^
    let^path = $"data/locale/{locale()}/images.lton"
    if^love.filesystem.getInfo(path) != nil^ { entries := readEntries(path) }
}

# The entry replacing the image file at path, if any.
public^let^entry = p^path:string^-> any^{
    load()
    return^entries[path]
}

let^number = f^v:any^, i:number^, default:number^-> number^{
    if^v fits^t^{number^[]} { return^v[i] ?? default }
    return^default
}

# How far a replaced image is moved from where it would be drawn.
public^let^offset = p^path:string^-> number^, number^{
    let^e = entry(path)
    if^e fits^t^{ offset : any^ } { return^number(e.offset, 0, 0), number(e.offset, 1, 0) }
    return^0, 0
}

# Drawn from a canvas holding the coloured text (premultiplied, as drawn
# onto a clear canvas): the text in its own colours, and `edge`
# where the text is within `radius` pixels (a square: the pixel art's
# outline). `weight` above 1 fills thin, faint strokes (small text's dashes
# and quotes) instead of letting the edge colour show through them. The
# result is straight (not premultiplied) alpha.
let^outlineCode = "extern vec2 texel;
extern number radius;
extern vec4 edge;
extern number weight;
vec4 effect(vec4 color, Image tex, vec2 uv, vec2 sc) {
    vec4 c = Texel(tex, uv);
    vec3 fill = c.a > 0.0 ? c.rgb / c.a : vec3(1.0);
    float a = min(c.a * weight, 1.0);
    float near = 0.0;
    for (int dy = -4; dy <= 4; dy++) {
        for (int dx = -4; dx <= 4; dx++) {
            if (float(max(abs(dx), abs(dy))) <= radius) {
                near = max(near, Texel(tex, uv + vec2(float(dx), float(dy)) * texel).a);
            }
        }
    }
    return vec4(mix(edge.rgb, fill, a), max(a, near * edge.a));
}
"
var^outline : love.graphics.Shader|nil^= nil^

var^fonts : t^{[string^]:love.graphics.Font|nil^} = {}

let^fontFor = p^file:string^, size:number^-> love.graphics.Font {
    let^key = $"{file}:{size}"
    let^known = fonts[key]
    if^known? { return^known }
    var^font = love.graphics.newFont(size)
    if^file != "" {
        let^f = love.graphics.newFont(file, size) catch^nil^
        if^f fits^love.graphics.Font { font := f }
    }
    fonts[key] := font
    return^font
}

let^Run = t^{ text:string^, font:love.graphics.Font, r:number^, g:number^, b:number^ }

# One block of text added to `out` (w x h): laid out and drawn in a canvas of
# its own, then put through the outline pass onto out, replacing what out
# holds unless `over` (then blended over the base image or earlier blocks).
let^drawBlock = p^e:any^, out:love.graphics.Texture, w:number^, h:number^, over:bool^{
    let^rect : any^= if^e fits^t^{ rect : any^ }: e.rect el^: nil^;
    let^rx = number(rect, 0, 0)
    let^ry = number(rect, 1, 0)
    let^rw = number(rect, 2, w)
    let^rh = number(rect, 3, h)
    let^file = if^e fits^t^{ font : string^ }: e.font el^: "";
    let^baseSize = if^e fits^t^{ fontSize : number^ }: e.fontSize el^: 12;
    let^colour : any^= if^e fits^t^{ color : any^ }: e.color el^: nil^;
    # The lines, each a list of runs; text = "..." or runs = {...} is one line.
    var^lines : t^{t^{Run[]}[]} = {}
    var^indents : t^{number^[]} = {}     # a line's indent = n: pixels before it
    let^addRun = p^into:t^{Run[]}, r:any^{
        var^text = ""
        var^size = baseSize
        var^c : any^= colour
        var^face = file
        if^r fits^t^{ text : string^ } { text := r.text }
        if^r fits^t^{ fontSize : number^ } { size := r.fontSize }
        if^r fits^t^{ color : any^ } { c := r.color }
        if^r fits^t^{ font : string^ } { face := r.font }
        if^text = "" { return^}
        into.push^({ text = text, font = fontFor(face, size), r = number(c, 0, 1), g = number(c, 1, 1), b = number(c, 2, 1) })
    }
    let^addLine = p^l:any^{
        var^runs : t^{Run[]} = {}
        if^l fits^t^{ runs : t^{any^[]} } {
            for^r in^l.runs { addRun(runs, r) }
        else^:
            addRun(runs, l)
        }
        if^runs.length^ > 0 {
            lines.push^(runs)
            indents.push^(if^l fits^t^{ indent : number^ }: l.indent el^: 0;)
        }
    }
    if^e fits^t^{ lines : t^{any^[]} } {
        for^l in^e.lines { addLine(l) }
    else^:
        addLine(e)
    }
    # wrap = true^: each line is a paragraph, broken between words to the
    # rect's width (a run's words keep its font and colour).
    if^e fits^t^{ wrap : bool^ } and^e.wrap {
        var^wrapped : t^{t^{Run[]}[]} = {}
        for^line in^lines {
            var^current : t^{Run[]} = {}
            var^used = 0
            for^r in^line {
                let^words = r.text.split(" ")
                for^word in^words {
                    let^last = index^ = words.length^ - 1
                    let^piece = if^last: word el^: word .. " ";
                    if^piece = "" { continue^}
                    if^used > 0 and^used + r.font.getWidth(word) > rw {
                        # The line ends here: its last word drops its space.
                        let^tail = current[current.length^ - 1]
                        if^tail != nil^ {
                            let^parts = tail.text.split(" ")
                            if^parts.length^ = 2 and^parts[1] = "" { tail.text := parts[0] ?? "" }
                        }
                        wrapped.push^(current)
                        current := {}
                        used := 0
                        if^word = "" { continue^}
                    }
                    current.push^({ text = piece, font = r.font, r = r.r, g = r.g, b = r.b })
                    used += r.font.getWidth(piece)
                }
            }
            if^current.length^ > 0 { wrapped.push^(current) }
        }
        lines := wrapped
        indents := {}
        for^line in^lines { indents.push^(0) }
    }
    let^align = if^e fits^t^{ align : string^ }: e.align el^: "left";
    let^valign = if^e fits^t^{ valign : string^ }: e.valign el^: "middle";
    let^leading = if^e fits^t^{ leading : number^ }: e.leading el^: 0;
    # stretch: letters widened (an extended face); skew: slanted to the right
    # by this much of their height (an italic).
    let^stretch = if^e fits^t^{ stretch : number^ }: e.stretch el^: 1;
    let^skew = if^e fits^t^{ skew : number^ }: e.skew el^: 0;
    # Each line shrunk on its own to the rect's width; the block set by valign.
    var^widths : t^{number^[]} = {}
    var^heights : t^{number^[]} = {}
    var^scales : t^{number^[]} = {}
    var^total = leading * std.math.max(lines.length^ - 1, 0)
    for^line in^lines {
        var^lw = 0
        var^lh = 0
        for^r in^line {
            lw += r.font.getWidth(r.text) * stretch
            lh := std.math.max(lh, r.font.getHeight())
        }
        let^room = rw - (indents[index^] ?? 0)
        let^scale = if^lw > room and^lw > 0: room / lw el^: 1;
        widths.push^(lw * scale + (indents[index^] ?? 0))
        heights.push^(lh * scale)
        scales.push^(scale)
        total += lh * scale
    }
    var^top = ry + (if^valign = "top": 0 el^valign = "bottom": rh - total el^: (rh - total) / 2;)

    # The text in its colours; the outline pass adds the edge.
    let^text = love.graphics.newCanvas(w, h)
    love.graphics.setCanvas(text)
    love.graphics.clear(0, 0, 0, 0)
    love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
    var^first : Run|nil^= nil^
    for^line in^lines {
        let^k = index^
        let^scale = scales[k] ?? 1
        let^bottom = top + (heights[k] ?? 0)
        let^lw = widths[k] ?? 0
        var^x = rx + (indents[k] ?? 0) + (if^align = "center": (rw - lw) / 2 el^align = "right": rw - lw el^: 0;)
        for^r in^line {
            if^first is^nil^ { first := r }
            love.graphics.setColor(r.r, r.g, r.b, 1)
            love.graphics.setFont(r.font)
            let^h2 = r.font.getHeight() * scale
            # The shear pivots on the top; moved so the slant leans from the bottom.
            love.graphics.print(r.text, (x + skew * h2).floor(), (bottom - h2).floor(), 0, scale * stretch, scale, 0, 0, -skew, 0)
            x += r.font.getWidth(r.text) * scale * stretch
        }
        top := bottom + leading
    }
    # underline = true^: a rule under the block across the rect, in the first
    # run's colour (the stage names' underline).
    if^e fits^t^{ underline : bool^ } and^e.underline {
        love.graphics.setColor(first?.r ?? 1, first?.g ?? 1, first?.b ?? 1, 1)
        love.graphics.rectangle(love.graphics.DrawMode.fill, rx, (top - leading + 2).floor(), rw, 2)
    }

    let^edge : any^= if^e fits^t^{ outline : t^{ color : any^ } }: e.outline.color el^: nil^;
    let^radius = if^e fits^t^{ outline : t^{ width : number^ } }: e.outline.width el^: 0;
    love.graphics.setCanvas(out)
    if^outline is^nil^ { outline := love.graphics.newShader(outlineCode) catch^nil^ }
    let^s = outline
    if^s fits^love.graphics.Shader {
        s.send("texel", { 1 / w, 1 / h })
        s.send("radius", radius)
        s.send("weight", if^e fits^t^{ weight : number^ }: e.weight el^: 1;)
        s.send("edge", { number(edge, 0, 0), number(edge, 1, 0), number(edge, 2, 0), if^radius > 0: 1 el^: 0; })
        love.graphics.setShader(s)
    }
    love.graphics.setBlendMode(if^over: love.graphics.BlendMode.alpha el^: love.graphics.BlendMode.replace;)
    love.graphics.setColor(1, 1, 1, 1)
    love.graphics.draw(text, 0, 0)
    love.graphics.setShader()
    text.dispose()
}

# A block's settings: the entry's, with the block's own on top.
let^merged = f^e:any^, b:any^-> t^{[string^]:any^}{
    var^out : t^{[string^]:any^} = {}
    if^e fits^t^{[string^]:any^} {
        for^k:string^, v:any^ in^e {
            if^k != "blocks" and^k != "erase" and^k != "base" { out[k] := v }
        }
    }
    if^b fits^t^{[string^]:any^} {
        for^k:string^, v:any^ in^b { out[k] := v }
    }
    return^out
}

# The canvas replacing the image file at path, nil^ when it is not replaced.
# Called on the main thread; the graphics state is left as it was.
#
# Text over the original (the images whose Japanese is a part of a larger
# picture): base = true^ starts from the file itself (an RGBA image), or
# base = "<path>" from another image; erase = { { x, y, w, h, color = { r, g,
# b, a } }, ... } paints rectangles over it (a = 0 clears them); blocks = {
# <settings>, ... } then sets several blocks of text, each with the entry's
# settings under its own.
public^let^render = p^path:string^-> love.graphics.Texture|nil^{
    let^e = entry(path)
    if^e is^nil^ { return^nil^ }
    let^size : any^= if^e fits^t^{ size : any^ }: e.size el^: nil^;
    let^w = std.math.max(number(size, 0, 1), 1)
    let^h = std.math.max(number(size, 1, 1), 1)

    let^previous = love.graphics.getCanvas()
    let^shader = love.graphics.getShader()
    let^font = love.graphics.getFont()
    let^mode, alphaMode = love.graphics.getBlendMode()
    let^cr, cg, cb, ca = love.graphics.getColor()
    love.graphics.push()
    love.graphics.origin()
    love.graphics.setShader()

    let^out = love.graphics.newCanvas(w, h)
    love.graphics.setCanvas(out)
    love.graphics.clear(0, 0, 0, 0)
    var^over = false^
    let^source = if^e fits^t^{ base : string^ }: e.base el^e fits^t^{ base : bool^ } and^e.base: path el^: "";
    if^source != "" {
        let^image = love.graphics.newImage(source) catch^nil^
        if^image fits^love.graphics.Texture {
            love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
            love.graphics.setColor(1, 1, 1, 1)
            love.graphics.draw(image, 0, 0)
            image.dispose()
        }
        over := true^
    }
    if^e fits^t^{ erase : t^{any^[]} } {
        love.graphics.setBlendMode(love.graphics.BlendMode.replace)
        for^r in^e.erase {
            let^c : any^= if^r fits^t^{ color : any^ }: r.color el^: nil^;
            love.graphics.setColor(number(c, 0, 0), number(c, 1, 0), number(c, 2, 0), number(c, 3, 1))
            love.graphics.rectangle(love.graphics.DrawMode.fill, number(r, 0, 0), number(r, 1, 0), number(r, 2, 0), number(r, 3, 0))
        }
        over := true^
    }
    if^e fits^t^{ blocks : t^{any^[]} } {
        for^b in^e.blocks {
            drawBlock(merged(e, b), out, w, h, over)
            over := true^
        }
    else^:
        drawBlock(e, out, w, h, over)
    }

    love.graphics.setShader()
    if^previous != nil^ { love.graphics.setCanvas(previous) else^: love.graphics.setCanvas() }
    love.graphics.pop()
    if^shader != nil^ { love.graphics.setShader(shader) }
    love.graphics.setFont(font)
    love.graphics.setBlendMode(mode, alphaMode)
    love.graphics.setColor(cr, cg, cb, ca)
    out.setFilter(love.graphics.FilterMode.nearest, love.graphics.FilterMode.nearest)
    return^out
}
