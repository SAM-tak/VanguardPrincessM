# The player's settings: settings.json in the save directory (TechnicalDocuments/0147).
# "lang" is the locale (src/locale.lh), "fullscreen" the window (Alt+Enter);
# key configuration lives under "input". Unknown settings are kept
# when it writes the file back. JSON rather than LTON: a distributed engine
# has no front end, and std.lton reads through one.
module^vp.settings

import^love.filesystem
import^std.json

let^FILE = "settings.json"

var^data : t^{[string^]:any^} = {}
var^loaded = false^
var^writable = true^

let^save = p^{
    if^!writable { return^ }
    let^text = try^std.json.pretty(data, 4)
    try^love.filesystem.write(FILE, text)
catch^:
    print($"Settings not written: {it^.message}")
}

# Without the file, the defaults are written as a new one, so the player has
# one to edit. "lang" is left out: unset, the locale follows the OS's language.
let^DEFAULTS : t^{[string^]:any^} = { fullscreen = false^ }

# Read once; a file that cannot be read is reported once and left as it is.
let^load = p^{
    if^loaded { return^}
    loaded := true^
    if^love.filesystem.getInfo(FILE) is^nil^ {
        for^k, v in^DEFAULTS { data[k] := v }
        save()
        return^
    }
    let^text = try^love.filesystem.read(FILE)
    if^text fits^string^ {
        let^raw = std.json.decode(text) catch^nil^
        if^raw fits^t^{[string^]:any^} {
            data := raw
            return^
        }
    }
    writable := false^
    print($"Settings not read: {FILE} is not a valid setting JSON file")
catch^:
    writable := false^
    print($"Cannot read {FILE}")
}

# Read the file again on next use (vp.locale.reload).
public^let^reload = p^{
    data := {}
    loaded := false^
    writable := true^
}

# The locale's name, "" when none is set.
public^let^lang = p^-> string^{
    load()
    let^v = data["lang"]
    return^if^v fits^string^: v el^: "";
}

public^let^fullscreen = p^-> bool^{
    load()
    let^v = data["fullscreen"]
    return^v fits^bool^ and^v
}

public^let^setFullscreen = p^on:bool^{
    load()
    data["fullscreen"] := on
    save()
}

public^let^playerName = p^-> string^{
    load()
    let^v = data["playerName"]
    return^if^v fits^string^: v el^: "Player";
}
public^let^setPlayerName = p^name:string^{
    load() data["playerName"] := name data["playerNameSource"] := "custom" save()
}
public^let^hasPlayerName = p^-> bool^{
    load()
    let^v = data["playerName"]
    # Older builds saved the fallback as though the player had chosen it.
    return^v fits^string^ and^v != "" and^(v != "Player" or^data["playerNameSource"] = "custom")
}

# Add only missing binding fields; preserve invalid values for manual correction.
public^let^inputConfig = p^defaults:t^{[string^]:t^{[string^]:string^}}, removedShortcuts:t^{string^[]}-> t^{[string^]:any^} {
    load()
    var^changed = false^
    var^config:t^{[string^]:any^} = {}
    let^old = data["input"]
    if^old fits^t^{[string^]:any^} { config := old else^: changed := true^ }
    for^section, entries in^defaults {
        var^group:t^{[string^]:any^} = {}
        let^existing = config[section]
        if^existing fits^t^{[string^]:any^} { group := existing else^: changed := true^ }
        for^action, value in^entries {
            if^group[action] is^nil^ { group[action] := value changed := true^ }
        }
        config[section] := group
    }
    let^shortcuts = config["shortcuts"]
    if^shortcuts fits^t^{[string^]:any^} {
        for^action in^removedShortcuts {
            if^shortcuts[action] != nil^ { shortcuts[action] := nil^ changed := true^ }
        }
    }
    if^changed { data["input"] := config save() }
    return^config
}
