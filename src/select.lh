# The character select screen, as FM2K's engine runs it (TechnicalDocuments/
# 0015). The demo "キャラセレ" draws the screen from system variables; the
# engine moves the cursors on the grid, puts the character under a cursor up
# as its portrait object. The port selects character and palette first,
# then support; A/C/E/F confirm; B/D cancel the main choice before support is locked.
#
# Story shows only 1P. In VS each player controls their own selection.
module^vp.select

import^love.graphics

require^"fighter.lh"
require^"sprite.lh"
require^"script.lh"
require^"stage.lh"
require^"hud.lh"
require^"round.lh"
require^"arena.lh"
require^"resource.lh"

let^Fighter = vp.fighter.Fighter

# The system file's built-in skills and its selection screen settings.
let^CURSOR_1P = 84
let^CURSOR_2P = 85
let^CONFIRMED_1P = 86
let^CONFIRMED_2P = 87
let^GRID_X = 320              # charStartPosX / Y, distanceBetweenCharsY, rows
let^GRID_Y = 50
let^GRID_STEP = 40
let^ROWS = 10
let^PORTRAIT_1P_X = 87        # p1CursorPosX / Y: where the portrait object stands
let^PORTRAIT_2P_X = 553
let^PORTRAIT_Y = 55
let^PORTRAIT = 25             # a character's built-in "select screen face"
let^SUPPORT_ORDER = { 104, 102, 101, 103 } # Kanae, Sierra, Eko, Juliet, left to right
let^ROULETTE_ORDER = { 101, 102, 103, 104, 105 }
public^let^PALETTE_COUNT = 6
# Resolve matching main colours for 2P, independent of confirmation order.
public^let^opponentColour = f^name1:string^, colour1:number^, name2:string^, colour2:number^-> number^{
    return^if^name1 = name2 and^colour1 = colour2: (colour2 + 1) % PALETTE_COUNT el^: colour2;
}
let^ROULETTE_INTERVAL = 8
let^AFTER_BOTH = 100          # frames from both confirmed to the battle

# The characters on the grid, top to bottom (the system file's list, under
# the port's names: tools/fm2k_convert/names.py).
public^let^CHARACTERS = { "ゆい", "はるか", "リリス", "ルナ", "くるみ", "サキ", "かえで", "ナタリア", "えり", "あやね" }

public^let^Side = def^{
    self^{
        row = 0,
        cursor : Fighter|nil^= nil^,
        portrait : Fighter|nil^= nil^,
        confirmed = false^,
        colour = 0,
        phase = "main",
        support = 101,
        supportSlot = 2,             # -1 / 4 are the two outside roulette slots
        roulette = false^,
        rouletteFrame = 0,
        rouletteIndex = 0,
        supportChanged = false^,
        controlParked = false^,
        horizontal = 0,
    },

    # Which side's system variable 141 (set when a side confirms) the portraits
    # see: each sees its own side's state (FM2K has one for both players).
    confirmFlag = p^self^, fighter:Fighter {
        fighter.setv(141, if^self^.confirmed: 1 el^: 0;)
        if^fighter.x > 320 { fighter.setv(134, if^self^.confirmed: 1 el^: 0;) }
    },
}

public^let^Select = def^{
    self^{
        system : vp.script.Script|nil^= nil^,
        systemDir = "",
        demo : vp.stage.Stage|nil^= nil^,
        demoScript : vp.script.Script|nil^= nil^,
        sides : t^{Side[]} = {},
        wait = 0,                   # frames since both confirmed
        done = false^,
        story = false^,
        # PRACTICE MODE: one player picks both sides, 2P's once 1P's is
        # confirmed (TechnicalDocuments/0145).
        solo = false^,
        handedOver = false^,        # solo: 1P's input now moves 2P's side
    },

    systemRun = p^self^, n:number^, x:number^, y:number^-> Fighter {
        let^l = Fighter.new(self^.systemDir, x, y)
        let^sc = self^.system
        if^sc != nil^ { sc.install(l) }
        l.system := true^
        l.depth := 101
        l.begin(n)
        l.ground := 1000000
        return^l
    },
    # The character under side k's cursor as its portrait object.
    showPortrait = p^self^, k:number^{
        let^maybe = self^.sides[k]
        if^maybe is^nil^{ return^}
        let^side : Side = maybe
        let^name = CHARACTERS[side.row] ?? "ゆい"
        let^p = Fighter.new($"assets/characters/{name}", if^k = 0: PORTRAIT_1P_X el^: PORTRAIT_2P_X;, PORTRAIT_Y)
        (portraitOf(name)).install(p)
        p.ground := 1000000
        p.onScreen := true^
        p.facing := if^k = 0: 1 el^: -1;
        p.depth := 100
        p.palette := side.colour
        side.support := 101
        side.supportSlot := 2
        side.roulette := false^
        side.rouletteFrame := 0
        side.rouletteIndex := 0
        side.supportChanged := false^
        side.controlParked := false^
        p.begin(PORTRAIT)
        side.portrait := p
        side.cursor := self^.systemRun(if^k = 0: CURSOR_1P el^: CURSOR_2P;, GRID_X, slotY(side.row))
    },
    # Initialize the face, then enter its existing support-choice branch.
    showSupport = p^self^, k:number^, support:number^{
        let^side = self^.sides[k]
        if^side is^nil^ or^support < 101 or^support > 105 { return^ }
        let^sd : Side = side
        let^face = sd.portrait
        if^face is^nil^ { return^ }
        let^p : Fighter = face
        sd.confirmFlag(p)
        p.record(5, 0)
        p.step()
        sd.support := support
        sd.supportChanged := true^
        let^name = CHARACTERS[sd.row] ?? "ゆい"
        let^sk = (portraitOf(name)).byId[p.skillNo]
        if^sk is^nil^ { return^ }
        for^at, b in^sk.blocks {
            if^b.op = "V" and^b.n[0] = 142 + k and^b.n[1] = 1 and^b.n[2] = 0 and^b.n[3] = support {
                p.waitTimer := 0
                p.start(p.skillNo, at)
                p.step()
                # The 1x1 root is a script controller. Keep its original COM /
                # roulette branches parked; objects continue to animate.
                sd.controlParked := true^
                # Roulette has its own outside marker; do not play the normal
                # arrow's movement sound each time the candidate changes.
                let^arrow = p.slots[0]
                if^sd.roulette and^arrow != nil^ { arrow.alive := false^ p.slots[0] := nil^ }
                p.setv(142 + k, support)
                self^.syncSupportDemo(k, support)
                return^
            }
        }
    },
    # Refresh the existing portrait/name/icon layers at the chosen value so
    # an eight-frame roulette change is visible before confirmation samples it.
    syncSupportDemo = p^self^, k:number^, support:number^{
        let^st = self^.demo
        if^st is^nil^ { return^ }
        let^script = self^.demoScript
        if^script is^nil^ { return^ }
        for^l in^st.layers {
            let^matches = if^k = 0: l.skillNo = 5 or^l.skillNo = 26 or^l.skillNo = 30 el^: l.skillNo = 7 or^l.skillNo = 25 or^l.skillNo = 29;
            if^!matches { continue^ }
            let^sk = script.byId[l.skillNo]
            if^sk is^nil^ { continue^ }
            for^b in^sk.blocks {
                if^b.op = "V" and^b.n[0] = 142 + k and^b.n[1] = 0 and^b.n[4] = 1 and^b.n[5] = support and^(b.n[6] ?? -1) >= 0 {
                    l.alive := true^
                    l.waitTimer := 0
                    l.start(b.n[6] ?? 0, b.n[7] ?? 0)
                    l.step()
                    break^
                }
            }
        }
    },
    restoreSupport = p^self^, k:number^, support:number^{
        let^sd = self^.sides[k]
        if^sd is^nil^ { return^ }
        sd.supportSlot := -1
        sd.roulette := support = 105
        sd.rouletteFrame := 0
        for^value in^SUPPORT_ORDER { if^value = support { sd.supportSlot := index^ } }
        for^value in^ROULETTE_ORDER { if^value = support { sd.rouletteIndex := index^ } }
        self^.showSupport(k, support)
    },
    colourAvailable = f^self^, k:number^, colour:number^-> bool^{
        let^sd = self^.sides[k]
        let^other = self^.sides[1 - k]
        return^sd is^nil^ or^other is^nil^ or^other.phase = "main" or^sd.row != other.row or^colour != other.colour
    },
    availableColour = f^self^, k:number^, colour:number^, direction:number^-> number^{
        return^if^self^.colourAvailable(k, colour): colour el^: (colour + direction + PALETTE_COUNT) % PALETTE_COUNT;
    },
    moveSupport = p^self^, k:number^, direction:number^{
        let^sd = self^.sides[k]
        if^sd is^nil^ { return^ }
        let^next = if^sd.roulette: (if^direction < 0: 3 el^: 0;) el^: (sd.supportSlot + direction).clamp(-1, 4);
        if^next = sd.supportSlot { return^ }
        sd.supportSlot := next
        sd.roulette := sd.supportSlot < 0 or^sd.supportSlot > 3
        sd.rouletteFrame := 0
        if^sd.roulette {
            sd.rouletteIndex := 0
            self^.showSupport(k, ROULETTE_ORDER[0])
        else^:
            self^.showSupport(k, SUPPORT_ORDER[sd.supportSlot] ?? 101)
        }
    },
    # Enter the portrait's original confirmation branch immediately, including
    # effects/voice, while preserving the support currently shown by roulette.
    finishSupport = p^self^, k:number^{
        let^sd = self^.sides[k]
        if^sd is^nil^ { return^ }
        let^p = sd.portrait
        if^p is^nil^ { return^ }
        let^sk = (portraitOf(CHARACTERS[sd.row] ?? "ゆい")).byId[p.skillNo]
        if^sk is^nil^ { return^ }
        for^b in^sk.blocks {
            if^b.op = "V" and^b.n[0] = (if^k = 0: 141 el^: 134;) and^b.n[1] = 0 and^(b.n[6] ?? -1) >= 0 {
                sd.controlParked := false^
                p.waitTimer := 0
                p.start(b.n[6] ?? 0, b.n[7] ?? 0)
                return^
            }
        }
    },
    # All human choices are confirmed (one in story, two in VS).
    bothChosen = f^self^-> bool^{
        let^first = self^.sides[0]
        let^last = self^.sides[if^self^.story: 0 el^: 1;]
        return^first != nil^ and^first.confirmed and^last != nil^ and^last.confirmed
    },
    # Both stages consume button edges; the main confirming press never
    # confirms support or hands input to another player in the same frame.
    step = p^self^, up:bool^, down:bool^, dir:number^, pressed:number^, up2:bool^, down2:bool^, dir2:number^, pressed2:number^{
        self^.demo?.step()
        let^solo = self^.solo and^!self^.story
        let^handOver = solo and^!self^.handedOver and^(self^.sides[0]?.confirmed ?? false^)
        let^second = solo and^self^.handedOver
        for^k from^0 to^(if^self^.story: 0 el^: 1;) {
            let^own = k = 0 or^second
            let^idle = solo and^k = 1 and^!second
            let^u = !idle and^(if^own: up el^: up2;)
            let^d = !idle and^(if^own: down el^: down2;)
            let^b = if^idle: 0 el^own: pressed el^: pressed2;
            let^buttonB = (b / 2).floor() % 2 = 1
            let^buttonD = (b / 8).floor() % 2 = 1
            let^cancel = buttonB or^buttonD
            let^confirm = b - (if^buttonB: 2 el^: 0;) - (if^buttonD: 8 el^: 0;)
            let^direction = if^idle: 5 el^own: dir el^: dir2;
            let^horizontal = (direction - 1) % 3 - 1
            let^side = self^.sides[k]
            if^side != nil^ {
                let^move = horizontal != 0 and^horizontal != side.horizontal
                side.horizontal := horizontal
                if^!side.confirmed {
                    if^side.phase = "support" and^cancel {
                        self^.returnToMain(k)
                    elseif^side.phase = "main":
                        if^u or^d {
                            side.row := (side.row + (if^d: 1 el^: -1;) + ROWS) % ROWS
                            side.colour := self^.availableColour(k, side.colour, 1)
                            self^.showPortrait(k)
                        elseif^move:
                            side.colour := (side.colour + horizontal + PALETTE_COUNT) % PALETTE_COUNT
                            side.colour := self^.availableColour(k, side.colour, horizontal)
                        elseif^confirm != 0:
                            side.colour := self^.availableColour(k, side.colour, 1)
                            side.phase := "support"
                            side.rouletteFrame := 0
                            side.supportChanged := true^
                            side.cursor?.sound(7)
                        }
                    else^:
                        if^move {
                            self^.moveSupport(k, horizontal)
                        elseif^confirm != 0:
                            side.confirmed := true^
                            side.phase := "ready"
                            self^.finishSupport(k)
                            side.cursor := self^.systemRun(if^k = 0: CONFIRMED_1P el^: CONFIRMED_2P;, GRID_X, slotY(side.row))
                        }
                    }
                }
            }
        }
        for^k, sd in^self^.sides {
            if^sd.phase = "main" { sd.colour := self^.availableColour(k, sd.colour, 1) }
            if^sd.phase = "support" and^sd.roulette and^!sd.supportChanged {
                sd.rouletteFrame += 1
                if^sd.rouletteFrame >= ROULETTE_INTERVAL {
                    sd.rouletteFrame := 0
                    sd.rouletteIndex := (sd.rouletteIndex + 1) % ROULETTE_ORDER.length^
                    self^.showSupport(k, ROULETTE_ORDER[sd.rouletteIndex] ?? 101)
                }
            }
            sd.supportChanged := false^
            let^p = sd.portrait
            if^p != nil^ {
                sd.confirmFlag(p)
                # Support is selected explicitly; neutral input keeps the old
                # portrait COM branches from consuming palette directions.
                p.record(5, 0)
                if^!sd.controlParked { p.step() }
                p.stepObjects()
                p.palette := sd.colour
                for^o in^p.objects { o.palette := sd.colour }
            }
            let^c = sd.cursor
            if^c != nil^ { c.step() c.stepObjects() }
        }
        if^handOver { self^.handedOver := true^ }
        if^self^.bothChosen() {
            self^.wait += 1
            if^self^.wait > AFTER_BOTH { self^.done := true^ }
        }
    },
    phase = f^self^, k:number^-> string^{ return^self^.sides[k]?.phase ?? "" },
    paletteVisible = f^self^, k:number^-> bool^{ return^self^.phase(k) = "main" },
    returnToMain = p^self^, k:number^{
        let^sd = self^.sides[k]
        if^sd is^nil^ or^sd.phase != "support" { return^ }
        sd.phase := "main"
        # Keep the direction latch: a held support direction must not turn
        # into a fresh palette move when B returns to character selection.
        self^.wait := 0
        self^.done := false^
    },
    # ESC follows the same cancellation limit. A locked side consumes back;
    # it must not drop the whole select scene and undo a completed choice.
    back = p^self^-> bool^{
        let^k = if^self^.solo and^self^.handedOver: 1 el^: 0;
        let^sd = self^.sides[k]
        if^sd is^nil^ { return^false^ }
        if^sd.phase = "support" { self^.returnToMain(k) return^true^ }
        for^side in^self^.sides { if^side.confirmed { return^true^ } }
        return^false^
    },
    # Side brightness is presentation only, never a script COLOR mutation.
    mainLight = f^self^, k:number^-> number^{ return^if^self^.phase(k) = "support": 0.35 el^: 1; },
    supportLight = f^self^, k:number^-> number^{ return^if^self^.phase(k) = "main": 0.35 el^: 1; },
    drawDemo = p^self^, st:vp.stage.Stage, from:number^, to:number^{
        for^k, l in^st.layers {
            if^k < from or^k >= to { continue^ }
            # The original instructions describe simultaneous support/colour
            # confirmation. Replace both backing/front layers in all locales.
            if^l.skillNo = 19 or^l.skillNo = 20 { continue^ }
            # Hidden Hilda has no slot in the four-icon row.
            if^l.skillNo = 30 and^self^.sides[0]?.support = 105 { continue^ }
            if^l.skillNo = 29 and^self^.sides[1]?.support = 105 { continue^ }
            var^light = 1
            if^l.skillNo = 5 or^l.skillNo = 26 or^l.skillNo = 30 { light := self^.supportLight(0) }
            if^l.skillNo = 7 or^l.skillNo = 25 or^l.skillNo = 29 { light := self^.supportLight(1) }
            vp.sprite.setBrightness(light)
            st.draw(0, 0, k, k + 1)
            vp.sprite.setBrightness(1)
        }
    },
    drawControls = p^self^{
        let^colours = vp.resource.data("data/select-palettes.lton")
        for^k from^0 to^(if^self^.story: 0 el^: 1;) {
            let^sd = self^.sides[k]
            if^sd is^nil^ { continue^ }
            let^name = CHARACTERS[sd.row] ?? "ゆい"
            let^rows : any^= if^colours != nil^: colours[name] el^: nil^;
            let^x = 16 + 328 * k
            let^paletteX = 80 + 350 * k
            if^self^.paletteVisible(k) {
                for^n from^0 to^PALETTE_COUNT - 1 {
                    let^c : any^= if^rows fits^t^{any^[]}: rows[n] el^: nil^;
                    let^r = if^c fits^t^{number^[]}: c[0] ?? 0.5 el^: 0.5;
                    let^g = if^c fits^t^{number^[]}: c[1] ?? 0.5 el^: 0.5;
                    let^b = if^c fits^t^{number^[]}: c[2] ?? 0.5 el^: 0.5;
                    love.graphics.setColor(if^n = sd.colour: 1 el^: 0.25;, if^n = sd.colour: 1 el^: 0.25;, if^n = sd.colour: 1 el^: 0.25;, 1)
                    love.graphics.rectangle(love.graphics.DrawMode.fill, paletteX + n * 21 - 2, 361, 20, 20)
                    let^light = if^self^.colourAvailable(k, n): 1 el^: 0.25;
                    love.graphics.setColor(r * light, g * light, b * light, 1)
                    love.graphics.rectangle(love.graphics.DrawMode.fill, paletteX + n * 21, 363, 16, 16)
                }
            }
            if^sd.phase = "support" and^sd.roulette {
                let^marker = vp.arena.texture("locale:select/random-marker")
                let^outsideX = if^k = 0: (if^sd.supportSlot < 0: 0 el^: 256;) el^: (if^sd.supportSlot < 0: 346 el^: 614;);
                love.graphics.setColor(1, 1, 1, 1)
                if^marker != nil^ { love.graphics.draw(marker, outsideX, 395) }
            }
            let^labelKey = if^sd.phase = "support" and^sd.roulette: "roulette" el^: sd.phase;
            let^label = vp.arena.texture($"locale:select/{labelKey}")
            let^hint = vp.arena.texture($"locale:select/{sd.phase}-hint")
            love.graphics.setColor(1, 1, 1, 1)
            if^label != nil^ { love.graphics.draw(label, x, 442) }
            if^hint != nil^ { love.graphics.draw(hint, x, 462) }
        }
        love.graphics.setColor(1, 1, 1, 1)
    },
    # The choices once done.
    chosen = p^self^, k:number^-> string^, number^{
        let^side = self^.sides[k]
        if^side is^nil^{ return^"ゆい", 0 }
        return^CHARACTERS[side.row] ?? "ゆい", side.colour
    },
    # Draws the screen in view coordinates, by depth as measured in the original
    # (TechnicalDocuments/0015): the demo's layers before ｼｽﾃﾑｲﾒｰｼﾞ位置 (12), the
    # portraits (80) and their big faces (79), the layers from the marker on
    # (100: the grid's icons), the cursors (101) and the support arrows (127).
    draw = p^self^{
        let^st = self^.demo
        if^st is^nil^{ return^}
        vp.fighter.setView(0, 0)
        self^.drawDemo(st, 0, st.players)
        var^list : t^{vp.round.Item[]} = {}
        let^add = p^f:Fighter, system:bool^, light:number^{
            let^i = vp.round.Item.new()
            i.depth := f.depth
            i.f := f
            i.system := system
            i.brightness := light
            list.push^(i)
        }
        # Solo: 2P's cursor stays hidden until 1P confirms (it still runs, for
        # the system variables it sets).
        let^hidden2 = self^.solo and^!self^.story and^!(self^.sides[0]?.confirmed ?? false^)
        for^k, sd in^self^.sides {
            let^p = sd.portrait
            if^p? {
                add(p, false^, self^.mainLight(k))
                for^o in^p.objects {
                    if^o.depth != 127 or^(sd.phase = "support" and^!sd.roulette) {
                        add(o, false^, if^o.depth = 127: 1 el^: self^.mainLight(k);)
                    }
                }
            }
            let^c = sd.cursor
            if^c? and^!(k = 1 and^hidden2) {
                add(c, true^, 1)
                for^o in^c.objects { add(o, true^, 1) }
            }
        }
        # Objects the screen'self^ layers spawn (the curtain the converter'self^ patch
        # moved to depth 127, TechnicalDocuments/0019): after the others, so over
        # those of the same depth.
        for^l in^st.layers {
            for^o in^l.objects { add(o, true^, 1) }
        }
        vp.round.byDepth(list)
        for^i in^list {
            if^i.depth <= 100 { i.draw() }
        }
        self^.drawDemo(st, st.players, st.layers.length^)
        for^i in^list {
            if^i.depth > 100 { i.draw() }
        }
        self^.drawControls()
    },
}

# Only portraits stay resident. Match wrappers must not retain every
# character/support combination after its resource arena has gone.
var^scripts : t^{[string^]:vp.script.Script|nil^} = {}

let^loadScript = p^name:string^, file:string^-> vp.script.Script{
    let^key = $"{name}/{file}"
    let^known = scripts[key]
    if^known? { return^known }
    let^sc = vp.script.load($"assets/characters/{name}/{file}") ?? vp.script.Script.new()
    scripts[key] := sc
    return^sc
}

public^let^scriptOf = p^name:string^-> vp.script.Script{
    return^vp.script.load($"assets/characters/{name}/script.lton") ?? vp.script.Script.new()
}

public^let^scriptFor = p^name:string^, support:number^-> vp.script.Script{
    return^vp.script.loadFor($"assets/characters/{name}/script.lton", support) ?? vp.script.Script.new()
}

let^portraitOf = p^name:string^-> vp.script.Script{
    return^loadScript(name, "portrait.lton")
}

let^slotY = f^row:number^-> number^{
    return^GRID_Y + GRID_STEP * row
}

public^let^load = p^systemDir:string^, story:bool^-> Select{
    let^s = Select.new()
    s.systemDir := systemDir
    s.story := story
    s.system := vp.script.load($"{systemDir}/script.lton")
    s.demo := vp.stage.load("assets/demos/キャラセレ")
    s.demoScript := vp.script.load("assets/demos/キャラセレ/script.lton")
    let^demo = s.demo
    if^demo != nil^ {
        for^layer in^demo.layers {
            # Confirmation belongs to the mode menu. The current converted
            # opening uses cue 3; also mute the original coin cue in slot 2.
            layer.mutedSounds[2] := true^
            layer.mutedSounds[3] := true^
        }
    }
    s.sides := { Side.new(), Side.new() }
    vp.fighter.clearSystemVars()
    # VS mode: both sides are up from the start (the 2P cursor #85 moves
    # system variable 139 off 500, the select screen's "1P only" mark, and
    # the screen lays itself out for two: 2P's support, no move list).
    s.showPortrait(0)
    if^!story { s.showPortrait(1) }
    return^s
}
