# Gamepads feed the same logical keys as the two keyboard layouts.
module^vp.input

import^love.keyboard
import^love.joystick
require^"settings.lh"
require^"keynames.lh"

let^Key = love.keyboard.Key
let^Button = love.joystick.Button
let^Slot = def^{ self^{pad:love.joystick.Joystick|nil^= nil^, held:t^{bool^[]} = {}} }
let^slots = {Slot.new(), Slot.new()}
let^keys : t^{t^{love.keyboard.Key[]}[]} = {
    {Key.up, Key.left, Key.down, Key.right, Key.z, Key.x, Key.c, Key.a, Key.s, Key.d, Key.escape, Key.return},
    {Key.u, Key.h, Key.j, Key.k, Key.l, Key.semicolon, Key.quote, Key.o, Key.p, Key.leftbracket, Key.escape, Key.return},
}
let^actions = {"up", "left", "down", "right", "a", "b", "c", "d", "e", "f", "back", "start"}
let^shortcutKeys = {Key.escape, Key.return, Key.f8}
let^shortcutActions = {"back", "start", "reload"}
let^fixedKeys = {Key.f1, Key.g, Key.f2, Key.t, Key.f5, Key.f3, Key.f4,
    Key.digit1, Key.digit2, Key.digit3, Key.digit4, Key.digit5, Key.digit6, Key.digit7, Key.digit8}
let^fixedActions = {"hitboxes", "guard", "quickKO", "stage", "soundLog", "cpu1", "cpu2",
    "palette1", "palette2", "palette3", "palette4", "palette5", "palette6", "palette7", "palette8"}
let^defaults:t^{[string^]:t^{[string^]:string^}} = {
    keyboard1 = {up="up",left="left",down="down",right="right",a="z",b="x",c="c",d="a",e="s",f="d"},
    keyboard2 = {up="u",left="h",down="j",right="k",a="l",b="semicolon",c="quote",d="o",e="p",f="leftbracket"},
    gamepad1 = {up="dpup",left="dpleft",down="dpdown",right="dpright",a="a",b="x",c="y",d="b",e="rightshoulder",f="leftshoulder",back="back",start="start"},
    gamepad2 = {up="dpup",left="dpleft",down="dpdown",right="dpright",a="a",b="x",c="y",d="b",e="rightshoulder",f="leftshoulder",back="back",start="start"},
    shortcuts = {back="escape",start="return",reload="f8"},
}
var^loaded = false^
var^keyboard:t^{[love.keyboard.Key]:t^{love.keyboard.Key[]}|nil^} = {}
var^pads:t^{t^{t^{button:love.joystick.Button|nil^}[]}[]} = {}
let^defaultName = f^section:string^, action:string^-> string^{
    let^group = defaults[section]
    return^if^group != nil^: group[action] ?? "" el^: "";
}
let^configured = p^config:t^{[string^]:any^}, section:string^, action:string^-> string^{
    let^group = config[section]
    if^group fits^t^{[string^]:any^} {
        let^v = group[action]
        if^v fits^string^ { return^v }
    }
    return^defaultName(section, action)
}
let^bind = p^logical:love.keyboard.Key, name:string^, fallback:string^{
    let^physical = vp.keynames.keys[name]
    if^name = "" { keyboard[logical] := {} return^ }
    let^key = physical ?? vp.keynames.keys[fallback]
    if^key != nil^ { keyboard[logical] := {key} }
}
let^load = p^{
    if^loaded { return^ }
    loaded := true^
    let^config = vp.settings.inputConfig(defaults, fixedActions)
    for^player, layout in^keys {
        let^section = $"keyboard{player + 1}"
        for^i from^0 to^9 {
            let^action = actions[i]
            let^logical = layout[i]
            if^logical != nil^ { bind(logical, configured(config, section, action), defaultName(section, action)) }
        }
        var^pad:t^{t^{button:love.joystick.Button|nil^}[]} = {}
        let^padSection = $"gamepad{player + 1}"
        for^action in^actions {
            let^name = configured(config, padSection, action)
            let^button = if^name = "": nil^ el^: vp.keynames.buttons[name] ?? vp.keynames.buttons[defaultName(padSection, action)];
            pad.push^({button=button})
        }
        pads.push^(pad)
    }
    for^logical in^fixedKeys { keyboard[logical] := {logical} }
    for^i, logical in^shortcutKeys {
        let^action = shortcutActions[i]
        if^action != nil^ { bind(logical, configured(config, "shortcuts", action), defaultName("shortcuts", action)) }
    }
}
public^let^reload = p^{
    loaded := false^ keyboard := {} pads := {}
    for^s in^slots { s.held := {} }
}
# Physical keyboard events become the same logical keys emitted by gamepads.
public^let^translate = p^physical:love.keyboard.Key-> t^{love.keyboard.Key[]} {
    load()
    var^out:t^{love.keyboard.Key[]} = {}
    for^logical, bindings in^keyboard {
        if^bindings != nil^ { for^key in^bindings { if^key = physical { out.push^(logical) } } }
    }
    return^out
}

# Automated tests: battle reads held keys (TechnicalDocuments/0090), which a
# keypressed event alone does not provide. `tap` holds a physical key for a few polls.
let^TAP_POLLS = 3
let^Tap = def^{
    self^{ key : love.keyboard.Key|nil^ = nil^, left = 0 },
    override^new = f^key:love.keyboard.Key, left:number^{ self^{ key = key, left = left } },
}
var^taps : t^{Tap[]} = {}
public^let^tap = p^key:love.keyboard.Key{
    for^t in^taps { if^t.key = key { t.left := TAP_POLLS return^ } }
    taps.push^(Tap.new(key, TAP_POLLS))
}

# Shared sampler keeps gamepad edges and held battle inputs in agreement.
public^let^samplePad = p^player:number^, down:p^love.joystick.Button-> bool^;, x:number^, y:number^-> t^{love.keyboard.Key[]} {
    load()
    var^events:t^{love.keyboard.Key[]} = {}
    let^mapping = pads[player]
    let^s = slots[player]
    let^layout = keys[player]
    if^mapping is^nil^ or^s is^nil^ or^layout is^nil^ { return^events }
    var^now:t^{bool^[]} = {}
    for^entry in^mapping {
        let^button = entry.button
        now.push^(button != nil^ and^down(button))
    }
    now[0] := (now[0] ?? false^) or^y < -0.35
    now[1] := (now[1] ?? false^) or^x < -0.35
    now[2] := (now[2] ?? false^) or^y > 0.35
    now[3] := (now[3] ?? false^) or^x > 0.35
    for^k, held in^now {
        let^key = layout[k]
        if^held and^!(s.held[k] ?? false^) and^key != nil^ { events.push^(key) }
    }
    s.held := now
    return^events
}

# Keep occupied slots stable when another controller disconnects.
public^let^poll = p^-> t^{love.keyboard.Key[]} {
    load()
    var^events : t^{love.keyboard.Key[]} = {}
    var^held : t^{Tap[]} = {}
    for^t in^taps {
        t.left -= 1
        if^t.left > 0 { held.push^(t) }
    }
    taps := held
    for^s in^slots {
        let^pad = s.pad
        if^pad? and^!pad.isConnected() { s.pad := nil^ s.held := {} }
    }
    for^pad in^love.joystick.getJoysticks() {
        if^pad.isGamepad() {
            var^assigned = false^
            for^s in^slots {
                let^other = s.pad
                if^other? and^other.getID() = pad.getID() {
                    assigned := true^
                }
            }
            if^!assigned {
                for^s in^slots { if^s.pad is^nil^ { s.pad := pad s.held := {} break^ } }
            }
        }
    }
    for^i, s in^slots {
        let^pad = s.pad
        let^layout = keys[i]
        if^pad != nil^ and^layout != nil^ {
            let^x = pad.getGamepadAxis(love.joystick.Axis.leftx)
            let^y = pad.getGamepadAxis(love.joystick.Axis.lefty)
            for^key in^samplePad(i, p^button:love.joystick.Button-> bool^{ return^pad.isGamepadDown(button) }, x, y) { events.push^(key) }
        }
    }
    return^events
}

let^physicalDown = p^key:love.keyboard.Key-> bool^{
    if^love.keyboard.isDown(key) { return^true^ }
    for^t in^taps { if^t.key = key { return^true^ } }
    return^false^
}
public^let^isDown = p^key:love.keyboard.Key-> bool^{
    load()
    let^bindings = keyboard[key]
    if^bindings != nil^ { for^physical in^bindings { if^physicalDown(physical) { return^true^ } }
    elseif^physicalDown(key): return^true^ }
    for^i, s in^slots {
        let^layout = keys[i]
        if^layout != nil^ {
            for^k, value in^layout {
                if^value = key and^(s.held[k] ?? false^) {
                    return^true^
                }
            }
        }
    }
    return^false^
}

public^let^heldButtons = p^player:number^-> number^{
    let^layout = keys[player]
    if^layout is^nil^ { return^0 }
    var^mask = 0
    var^bit = 1
    for^i from^4 to^9 {
        let^key = layout[i]
        if^key != nil^ and^isDown(key) { mask += bit }
        bit *= 2
    }
    return^mask
}
