# The custom opening (TechnicalDocuments/0026) and the mode menu (0016).
# The opening uses only the original images and sounds; its script is not run.
# The mode menu comes from the game's demo assignment (demos.lton, read
# from the .kgt by tools/fm2k_convert/read_demos.py).
#
# - The opening lasts 35 seconds; a button skips to the title still.
#   A separate press on the title still proceeds to the mode menu.
# - The title demo is the mode menu. The engine puts the system's title
#   cursor (#78) at the chosen item's position (#79 story, #80 VS); the
#   cursor's #107 reads its y and shows the item's caption.
# - PRACTICE MODE is the port's third item (TechnicalDocuments/0145): its
#   caption is localized text (src/locale.lh; the original has none), drawn
#   where #107 shows the others.
# - SURVIVAL / ONLINE VS / LAN VS MODE are listed but not yet made: their
#   caption is a localized "under construction", and a press does nothing.
# - WATCH REPLAY opens the list of saved replays over the menu, without a
#   change of screen (src/replaylist.lh); the menu waits while it is open.
# - All the items' labels are localized text in one face, over a background
#   without the original's STORY MODE / VS MODE (data/images/modeselectbg.png
#   in place of image 7, by the locales' entries).
module^vp.title

import^love.graphics
import^love.audio

require^"fighter.lh"
require^"script.lh"
require^"stage.lh"
require^"round.lh"
require^"arena.lh"
require^"resource.lh"
require^"locale.lh"
require^"replaylist.lh"

let^Fighter = vp.fighter.Fighter

let^CURSOR = 78
let^ITEM_X = 291              # "position: title cursor" story (#79) / VS single (#80)
let^ITEM_Y : t^{number^[]} = { 70, 92, 114, 136, 158, 180, 202 }
let^PRACTICE = 2
let^UNMADE = 3                # this item to LAN VS (5) is not made yet
let^REPLAY = 6
# The items' labels, at the cursor's rows (the original's were at y 64 /
# 88 from x 300).
let^LABELS : t^{string^[]} = {
    "locale:mode-menu/story", "locale:mode-menu/vs", "locale:mode-menu/practice",
    "locale:mode-menu/survival", "locale:mode-menu/online", "locale:mode-menu/lan",
    "locale:mode-menu/replay",
}
let^LABEL_X = 300
let^LABEL_Y = 60
let^LABEL_GAP = 22
# The port's items' captions, by item ("": #107's own).
let^UNMADE_CAPTION = "locale:mode-menu/unmade-caption"
let^CAPTIONS : t^{string^[]} = {
    "", "", "locale:mode-menu/practice-caption",
    UNMADE_CAPTION, UNMADE_CAPTION, UNMADE_CAPTION,
    "locale:mode-menu/replay-caption",
}
let^CAPTION = 107             # the cursor's caption object
let^MOVE_SOUND = 8            # the system sound #107 plays for a move
let^MODE_CURTAIN = 7         # mode demo's スクリプト4: image 11 fading to transparent
let^OPENING_DIR = "assets/demos/タイトル"
let^SCROLL_SECONDS = 35
let^FLASH_SECONDS = 0.35
let^CREDIT_GAP = 64
let^CREDIT_FADE_HEIGHT = 96     # fade within the top / bottom fifth of the view

# The game's demo assignment and each demo's settings.
public^let^Demos = def^{
    self^{
        opening = "",
        title = "",
        vsSelect = "",
        skips : t^{[string^]:bool^|nil^} = {},
        times : t^{[string^]:number^|nil^} = {},
    },

    play = p^self^, name:string^-> Scene {
        let^s = Scene.new()
        s.name := name
        s.layers := vp.stage.load($"assets/demos/{name}")
        s.time := self^.times[name] ?? 0
        s.skip := self^.skips[name] ?? false^
        return^s
    },

    # The title screen: the menu demo and the cursor, on story mode as in the
    # original. The caller uses item to choose story or VS mode.
    titleScreen = p^self^, systemDir:string^, system:vp.script.Script-> Scene {
        let^s = self^.play(self^.title)
        s.item := 0
        s.extras := { systemRun(systemDir, system, CURSOR, ITEM_X, ITEM_Y[0] ?? 70) }
        for^key in^LABELS { s.labels.push^(vp.arena.texture(key)) }
        for^key in^CAPTIONS {
            if^key != "" { s.captions[key] := vp.arena.texture(key) }
        }
        vp.replaylist.close()
        let^st = s.layers
        if^st != nil^ {
            for^k, l in^st.layers {
                if^l.skillNo = MODE_CURTAIN { s.curtainLayer := k }
            }
        }
        return^s
    },
}

public^let^loadDemos = p^systemDir:string^-> Demos {
    let^d = Demos.new()
    let^raw = vp.resource.data($"{systemDir}/demos.lton")
    if^raw fits^t^{ opening : string^, title : string^, vsSelect : string^ } {
        d.opening := raw.opening
        d.title := raw.title
        d.vsSelect := raw.vsSelect
    }
    if^raw fits^t^{ demos : t^{} } {
        let^list = raw.demos
        for^e:t^{ name : string^, skip : bool^, time : number^ } in^list {
            d.skips[e.name] := e.skip
            d.times[e.name] := e.time
        }
    }
    return^d
}

# A demo on screen: its layers, and what the engine adds (the title cursor).
public^let^Scene = def^{
    self^{
        name = "",
        layers : vp.stage.Stage|nil^= nil^,
        extras : t^{Fighter[]} = {},
        curtainLayer = -1,          # mode menu fade drawn after cursor and caption
        frames = 0,
        time = 0,                   # frames it lasts, 0: no limit
        skip = false^,              # a button ends it
        item = 0,                   # the title menu's choice (0 story, 1 VS, 2 practice, 3-5 not made, 6 replays)
        captionItem = 0,            # #107's branch: the last of story / VS the cursor was on
        labels : t^{(love.graphics.Texture|nil^)[]} = {},
        captions : t^{[string^]:love.graphics.Texture|nil^} = {},
        done = false^,
        exitFrames = -1,
        confirmSound : love.audio.Source|nil^= nil^,
        customOpening = false^,
        elapsed = 0,
        idleSeconds = 0,
        attractReady = false^,
        titleShown = false^,
        flash = 0,
        images : t^{[number^]:love.graphics.Texture|nil^} = {},
        creditHeight = 0,
        music : love.audio.Source|nil^= nil^,
    },

    revealTitle = p^self^{
        self^.titleShown := true^
        self^.flash := FLASH_SECONDS
        # Keep the opening music playing through the reveal (including a skip).
        # Returning from the mode menu creates a silent scene instead.
    },
    # Real seconds, independent of the battle's capped 100 Hz catch-up loop.
    # A press that skips the scroll is consumed here, never by the mode menu.
    updateOpening = p^self^, dt:number^, pressed:number^{
        self^.elapsed += dt
        if^pressed != 0 { self^.idleSeconds := 0 else^: self^.idleSeconds += dt }
        let^music = self^.music
        self^.attractReady := pressed = 0 and^(if^music != nil^: !music.isPlaying() el^: self^.idleSeconds >= 30;)
        if^self^.titleShown {
            self^.flash := (self^.flash - dt).clamp(0, FLASH_SECONDS)
            if^pressed != 0 { self^.done := true^ }
            return^
        }
        if^pressed != 0 or^self^.elapsed >= SCROLL_SECONDS {
            self^.revealTitle()
            return^
        }
    },
    drawOpening = p^self^{
        love.graphics.setColor(1, 1, 1, 1)
        if^self^.titleShown {
            let^tex = self^.images[0]
            if^tex != nil^ { love.graphics.draw(tex, 0, 0) }
            if^self^.flash > 0 {
                love.graphics.setColor(1, 1, 1, self^.flash / FLASH_SECONDS)
                love.graphics.rectangle(love.graphics.DrawMode.fill, 0, 0, 640, 480)
                love.graphics.setColor(1, 1, 1, 1)
            }
        else^:
            let^progress = (self^.elapsed / SCROLL_SECONDS).clamp(0, 1)
            let^background = self^.images[5]
            if^background != nil^ {
                let^w, h = background.getDimensions()
                love.graphics.draw(background, -(w - 640) * progress, 0)
            }
            var^y = 480 - (480 + self^.creditHeight) * progress
            for^n from^6 to^16 {
                let^tex = self^.images[n]
                if^tex != nil^ {
                    let^w, h = tex.getDimensions()
                    # Only the final line stays at the centre until the title reveal.
                    let^at = if^n = 16 and^y < (480 - h) / 2: (480 - h) / 2 el^: y;
                    let^centre = at + h / 2
                    let^alpha = ((480 - centre) / CREDIT_FADE_HEIGHT).clamp(0, 1) * (centre / CREDIT_FADE_HEIGHT).clamp(0, 1)
                    if^at < 480 and^at + h > 0 {
                        love.graphics.setColor(1, 1, 1, alpha)
                        love.graphics.draw(tex, (640 - w) / 2, at)
                    }
                    y += h
                }
                y += CREDIT_GAP
            }
        }
        # Keep the prompt'self^ blink phase continuous through the title reveal.
        love.graphics.setColor(1, 1, 1, 1)
        if^(self^.elapsed / 0.25).floor() % 2 = 0 {
            let^prompt = self^.images[1]
            if^prompt != nil^ {
                # Original title script: COLOR 3 (subtract), preserving the
                # image'self^ grey edge pixels instead of flattening them to black.
                if^self^.titleShown { love.graphics.setBlendMode(love.graphics.BlendMode.subtract) }
                love.graphics.draw(prompt, 171, 421)
                love.graphics.setBlendMode(love.graphics.BlendMode.alpha)
                love.graphics.setColor(1, 1, 1, 1)
            }
        }
    },
    # One frame. up / down: pressed this frame; pressed: buttons pressed.
    step = p^self^, up:bool^, down:bool^, pressed:number^{
        if^self^.exitFrames >= 0 {
            if^self^.exitFrames < 50 { self^.exitFrames += 1 }
            if^self^.exitFrames >= 50 { self^.done := true^ }
            return^
        }
        let^st = self^.layers
        if^st != nil^ { st.step() }
        self^.frames += 1
        let^cursor = self^.extras[0]
        if^cursor? and^vp.replaylist.isOpen() {
            vp.replaylist.step(up, down, pressed)
        elseif^cursor?:
            if^up or^down {
                let^count = ITEM_Y.length^
                self^.item := (self^.item + (if^down: 1 el^: count - 1;)) % count
                cursor.y := ITEM_Y[self^.item] ?? 92
                # #107 sounds a move only when the cursor reaches the other of
                # story / VS than its branch; the port's items' y is neither, so
                # moves onto them, and back to the branch's own item, sound here.
                if^self^.item >= PRACTICE or^self^.item = self^.captionItem {
                    cursor.sound(MOVE_SOUND)
                else^:
                    self^.captionItem := self^.item
                }
            }
            if^pressed != 0 and^self^.item = REPLAY {
                cursor.sound(MOVE_SOUND)
                vp.replaylist.open()
            elseif^pressed != 0 and^self^.item < UNMADE:
                let^cue = vp.arena.sound($"assets/demos/{self^.name}/sounds/0002.wav", false^)
                self^.confirmSound := cue
                if^cue != nil^ { cue.stop() cue.play() }
                self^.exitFrames := 0
            }
        else^:
            if^(self^.skip and^pressed != 0) or^(self^.time > 0 and^self^.frames >= self^.time) { self^.done := true^ }
        }
        for^e in^self^.extras {
            e.step()
            e.stepObjects()
        }
    },
    # Draws a demo scene in view coordinates, by depth (layers 12 / 100, the
    # cursor 101, its caption 127).
    draw = p^self^{
        if^self^.customOpening { self^.drawOpening() return^ }
        let^st = self^.layers
        if^st is^nil^{ return^}
        vp.fighter.setView(0, 0)
        var^list : t^{vp.round.Item[]} = {}
        for^e in^self^.extras {
            let^i = vp.round.Item.new()
            i.depth := e.depth
            i.f := e
            i.system := true^
            list.push^(i)
            for^o in^e.objects {
                let^j = vp.round.Item.new()
                j.depth := o.depth
                j.f := o
                j.system := true^
                list.push^(j)
            }
        }
        vp.round.byDepth(list)
        st.draw(0, 0, 0, st.players)
        love.graphics.setColor(1, 1, 1, 1)
        for^label in^self^.labels {
            if^label != nil^ {
                let^dx, dy = vp.locale.offset(LABELS[index^] ?? "")
                love.graphics.draw(label, LABEL_X + dx, LABEL_Y + LABEL_GAP * index^ + dy)
            }
        }
        # On the port's items, #107 (which knows only story and VS) gives way
        # to their caption, drawn where it shows its own.
        let^practice = self^.item >= PRACTICE
        let^captionKey = CAPTIONS[self^.item] ?? ""
        let^caption = self^.captions[captionKey]
        let^show = p^i:vp.round.Item{
            let^f = i.f
            if^practice and^f != nil^ and^f.skillNo = CAPTION {
                if^caption != nil^ and^f.alive {
                    let^dx, dy = vp.locale.offset(captionKey)
                    love.graphics.setColor(1, 1, 1, 1)
                    love.graphics.draw(caption, f.x + f.ix + dx, f.y + f.iy + dy)
                }
                return^
            }
            i.draw()
        }
        for^i in^list {
            if^i.depth <= 100 { show(i) }
        }
        for^k, l in^st.layers {
            if^k >= st.players and^k != self^.curtainLayer {
                st.draw(0, 0, k, k + 1)
            }
        }
        for^i in^list {
            if^i.depth > 100 { show(i) }
        }
        # Deliberate presentation change: the original fade layer (depth 100)
        # covers the cursor (101) and its caption (127), keeping its own timing.
        if^self^.curtainLayer >= 0 {
            st.draw(0, 0, self^.curtainLayer, self^.curtainLayer + 1)
        }
        if^self^.exitFrames >= 0 {
            love.graphics.setColor(0, 0, 0, self^.exitFrames / 50)
            love.graphics.rectangle(love.graphics.DrawMode.fill, 0, 0, 640, 480)
            love.graphics.setColor(1, 1, 1, 1)
        }
    },
}

let^openingSound = p^n:number^-> love.audio.Source|nil^{
    return^vp.arena.sound($"{OPENING_DIR}/sounds/{n:%04d}.wav", false^)
}

public^let^openingScreen = p^animate:bool^-> Scene {
    let^s = Scene.new()
    s.customOpening := true^
    s.name := "タイトル"
    for^n from^0 to^16 {
        if^n < 2 or^n >= 5 {
            let^tex = vp.arena.texture($"{OPENING_DIR}/images/{n:%04d}.png")
            s.images[n] := tex
            if^n >= 6 and^tex != nil^ {
                let^w, h = tex.getDimensions()
                s.creditHeight += h
            }
        }
    }
    s.creditHeight += CREDIT_GAP * 10
    if^animate {
        s.music := openingSound(1)
        let^music = s.music
        if^music != nil^ { music.play() }
    else^:
        s.revealTitle()
    }
    return^s
}

let^systemRun = p^systemDir:string^, sc:vp.script.Script, n:number^, x:number^, y:number^-> Fighter {
    let^l = Fighter.new(systemDir, x, y)
    sc.install(l)
    l.system := true^
    l.onScreen := true^
    l.depth := 101
    l.begin(n)
    l.ground := 1000000
    return^l
}
