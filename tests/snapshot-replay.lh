# Snapshots (TechnicalDocuments/0156): while a recorded VS match (CPUs, as in
# replay-roundtrip) plays back, its state is taken at one frame, the match
# runs on, is put back, and runs on again: the same frame must look the same
# both times, and the replay must still end as the match did. The second time
# the snapshot is put back after being used once, so it must not have changed.
module^vp.snapshotreplay
import^love.keyboard
import^love.event
import^love.filesystem
import^love.timer
require^"../main.lh"
require^"../tests/select-input.lh"
require^"../src/arena.lh"
require^"../src/replaylist.lh"

var^phase = 0
var^wait = 0
var^began = 0
var^saved = ""
var^downs = 0                # down presses still to make, one a frame
let^SNAP_AT = 1000
let^BACK_AT = 1400
var^snap : vp.main.Saved|nil^= nil^
var^target = -1               # the frame compared after each rewind
var^seen = ""
var^rewinds = 0
var^compared = 0
let^Key = love.keyboard.Key
let^press = p^key:love.keyboard.Key{ vp.selectinput.press(key) }
let^fail = p^why:string^{
    if^saved != "" { let^_^ = love.filesystem.remove($"replays/{saved}") }
    panic^why
}

# One frame of the played replay: take, compare and put back.
let^rewind = p^{
    let^at = vp.main.status().replayFrame
    if^!vp.main.status().replaying { return^ }
    if^snap is^nil^ and^at >= SNAP_AT {
        let^t0 = love.timer.getTime()
        snap := vp.main.snapshot()
        let^t1 = love.timer.getTime()
        let^taken = snap
        if^taken != nil^ { vp.main.restore(taken) }
        let^t2 = love.timer.getTime()
        print($"snapshot at frame {at}: take {(t1 - t0) * 1000:%.2f} ms, put back {(t2 - t1) * 1000:%.2f} ms")
        return^
    }
    let^s = snap
    if^s is^nil^ { return^ }
    if^rewinds = 0 and^at >= BACK_AT {
        target := at
        seen := vp.main.signature()
    }
    if^target >= 0 and^at = target {
        let^now = vp.main.signature()
        if^rewinds > 0 {
            if^now != seen { fail($"after rewind {rewinds}, frame {at} differs:
  first: {seen}
  again: {now}") }
            compared += 1
        }
        if^rewinds < 2 {
            vp.main.restore(s)
            rewinds += 1
            print($"rewound to frame {vp.main.status().replayFrame} from {at}")
        }
    }
}

public^let^load = p^{
    began := love.timer.getTime()
    vp.main.setVSSeconds(5)
    vp.main.load()
}
public^let^update = p^dt:number^{
    # Matches run several frames a frame; menus one.
    let^s0 = vp.main.status()
    let^fast = s0.phase = "battle" or^s0.phase = "match-intro"
    for^i from^1 to^(if^fast: 8 el^: 1;) {
        vp.main.update(0.02)
        if^phase = 9 { rewind() }
    }
    if^downs > 0 { press(Key.down) downs -= 1 }
    let^s = vp.main.status()
    let^where = vp.arena.names()
    if^phase = 0 and^where = "system / opening" { press(Key.z) phase := 1
    elseif^phase = 1: press(Key.z) phase := 2
    elseif^phase = 2 and^where = "system / title":
        wait += 1
        if^wait = 20 { press(Key.down) }
        if^wait = 30 { press(Key.z) phase := 3 wait := 0 }
    elseif^phase = 3 and^s.phase = "select" and^!s.loading:
        press(Key.f3)
        press(Key.f4)
        press(Key.z)
        phase := 4
    elseif^phase = 4:
        press(Key.l) phase := 5
    elseif^phase = 5 and^s.phase = "battle":
        if^!s.recording { fail("VS did not record") }
        if^!s.cpuFirst or^!s.cpuSecond { fail("F3 / F4 did not hand both sides to the CPU") }
        phase := 6
    elseif^phase = 6 and^s.phase = "select":
        saved := s.lastReplay
        if^saved = "" or^love.filesystem.getInfo($"replays/{saved}") is^nil^ { fail("no replay was saved") }
        print($"recorded {saved}: wins {s.wins}-{s.losses}")
        press(Key.escape)
        phase := 7
        wait := 0
    elseif^phase = 7 and^where = "system / title":
        wait += 1
        if^wait = 20 { press(Key.up) }          # STORY wraps round to WATCH REPLAY
        if^wait = 30 { press(Key.z) }
        if^wait = 40 {
            var^at = -1
            for^name in^vp.replaylist.entries() { if^name = saved { at := index^ } }
            if^at < 0 { fail($"{saved} is not listed") }
            downs := at
        }
        if^wait = 50 { press(Key.z) phase := 8 }
    elseif^phase = 8 and^s.replaying and^s.phase = "battle":
        phase := 9
    elseif^phase = 9 and^!s.replaying and^where = "system / title":
        let^_^ = love.filesystem.remove($"replays/{saved}")
        if^rewinds < 2 { panic^$"only {rewinds} rewinds happened" }
        if^compared < 2 { panic^$"the frame after a rewind was compared {compared} times" }
        if^!s.replayMatched { panic^"after the rewinds the replay did not end as the match did" }
        print($"PASS: snapshot at {SNAP_AT}, put back twice from frame {target}: the same frame again, and the replay's end as recorded")
        love.event.quit()
    }
    if^love.timer.getTime() - began > 300 { fail($"snapshot replay timeout at phase {phase}") }
}
public^let^draw = p^{ vp.main.draw() }
public^let^quit = p^-> bool^{ return^vp.main.quit() }
