# Round-start playback: a VS match (both sides the CPU's: F3 / F4, 5-second rounds) is recorded to
# replays/; WATCH REPLAY then plays it from its inputs and must end as the
# match did (frames, wins and lives). The test's replay is removed afterwards.
module^vp.replayroundstart
import^love.keyboard
import^love.event
import^love.filesystem
import^love.timer
require^"../main.lh"
require^"../tests/select-input.lh"
require^"../src/arena.lh"
require^"../src/replaylist.lh"
require^"../src/replay.lh"

var^phase = 0
var^wait = 0
var^began = 0
var^saved = ""
var^expected:t^{[number^]:string^|nil^} = {}
var^partial = false^
var^first = 0
var^compared = 0
var^targetRound = 2
var^downs = 0                # down presses still to make, one a frame
let^Key = love.keyboard.Key
let^press = p^key:love.keyboard.Key{ vp.selectinput.press(key) }
let^fail = p^why:string^{
    if^saved != "" { let^_^ = love.filesystem.remove($"replays/{saved}") }
    panic^why
}

public^let^load = p^{
    began := love.timer.getTime()
    vp.main.setVSSeed(123456)
    vp.main.setVSSeconds(5)
    vp.main.load()
}
public^let^update = p^dt:number^{
    # Matches run several frames a frame; menus one.
    let^s0 = vp.main.status()
    let^fast = s0.phase = "battle" or^s0.phase = "match-intro"
    for^i from^1 to^(if^fast: 16 el^: 1;) {
        vp.main.update(0.01)
        let^now = vp.main.status()
        if^now.replaying and^now.phase = "battle" and^!now.loading {
            let^signature = vp.main.signature()
            let^state = signature.substring(signature.find(" ") ?? 0)
            if^!partial { expected[now.replayFrame] := state
            else^:
                if^now.replayFrame < first { fail("partial playback simulated an earlier round") }
                let^before = expected[now.replayFrame]
                if^before != nil^ and^before != state { fail($"round-start state mismatch at {now.replayFrame}: {before} != {state}") }
                if^before != nil^ { compared += 1 }
            }
        }
    }
    if^downs > 0 { press(Key.down) downs -= 1 }
    let^s = vp.main.status()
    let^where = vp.arena.names()
    if^phase = 0 and^where = "system / opening" { press(Key.z) phase := 1
    elseif^phase = 1: press(Key.z) phase := 2
    elseif^phase = 2 and^where = "system / title":
        wait += 1
        if^wait = 20 { press(Key.down) }
        if^wait = 30 { press(Key.z) phase := 3 wait := 0 }
    elseif^phase = 3 and^s.phase = "select" and^!s.loading:
        press(Key.f3)
        press(Key.f4)
        press(Key.z)
        phase := 4
    elseif^phase = 4:
        press(Key.l) phase := 5
    elseif^phase = 5 and^s.phase = "battle":
        if^!s.recording { fail("VS did not record") }
        if^!s.cpuFirst or^!s.cpuSecond { fail("F3 / F4 did not hand both sides to the CPU") }
        phase := 6
    elseif^phase = 6 and^s.phase = "select":
        saved := s.lastReplay
        if^saved = "" or^love.filesystem.getInfo($"replays/{saved}") is^nil^ { fail("no replay was saved") }
        let^tape = vp.replay.load(saved)
        if^tape is^nil^ { fail("recorded replay could not be read") return^ }
        if^tape.legacy or^tape.rounds.length^ < 2 { fail("match was not divided into rounds") }
        var^total = 0
        for^r in^tape.rounds {
            if^r.number != index^ + 1 or^r.first != total or^r.random = 0 { fail("invalid recorded round boundary") }
            let^length = tape.roundFrames(index^)
            if^length <= 0 { fail("empty recorded round") }
            total += length
        }
        if^total != tape.frames() { fail("round blocks do not cover the match") }
        print($"round blocks: {tape.rounds.length^}, {total} total frames")
        print($"recorded {saved}: wins {s.wins}-{s.losses}")
        press(Key.escape)
        phase := 7
        wait := 0
    elseif^phase = 7 and^where = "system / title":
        wait += 1
        if^wait = 20 { press(Key.up) }          # STORY wraps round to WATCH REPLAY
        if^wait = 30 { press(Key.z) }
        if^wait = 40 {
            var^at = -1
            for^name in^vp.replaylist.entries() { if^name = saved { at := index^ } }
            if^at < 0 { fail($"{saved} is not listed") }
            downs := at
        }
        if^wait = 50 { press(Key.z) phase := 8 }
    elseif^phase = 8 and^s.replaying and^s.phase = "battle":
        phase := 9
    elseif^phase = 9 and^!s.replaying and^!s.loading and^where = "system / title":
        if^!s.replayMatched { fail("full playback did not match") }
        let^tape = vp.replay.load(saved)
        if^tape is^nil^ { fail("replay missing before round-start test") return^ }
        let^round = tape.rounds[1]
        if^round is^nil^ or^round.checkpoint = "" { fail("round 2 has no portable starting data") return^ }
        first := round.first
        # Poison all earlier input. Matching playback must restore the round,
        # rather than catch up by secretly running round 1.
        for^i from^0 to^first - 1 { tape.side1[i] := 1023 tape.side2[i] := 1023 }
        let^_^ = love.filesystem.write($"replays/{saved}", tape.encode()) catch^false^
        partial := true^
        vp.main.playReplay(saved, 2)
        phase := 10
    elseif^phase = 10 and^s.replaying and^s.phase = "battle" and^!s.loading:
        if^s.replayStartRound != targetRound or^s.replayFirstFrame != first { fail("round-start playback began at the wrong frame") }
        phase := 11
    elseif^phase = 11 and^!s.replaying and^where = "system / title":
        if^!s.replayMatched { panic^"round-start playback did not end as recorded" }
        if^compared < 500 { panic^"too few frames compared" }
        if^s.loading { return^ }
        let^tape = vp.replay.load(saved)
        if^tape != nil^ and^targetRound = 2 and^tape.rounds.length^ >= 3 {
            let^round = tape.rounds[2]
            if^round is^nil^ or^round.checkpoint = "" { fail("round 3 has no starting data") return^ }
            first := round.first targetRound := 3
            for^i from^0 to^first - 1 { tape.side1[i] := 1023 tape.side2[i] := 1023 }
            let^_^ = love.filesystem.write($"replays/{saved}", tape.encode()) catch^false^
            vp.main.playReplay(saved, 3)
            phase := 10 return^
        }
        let^_^ = love.filesystem.remove($"replays/{saved}")
        print($"PASS: later rounds start independently of poisoned earlier input; {compared} fighter/stage states and final result match full playback")
        love.event.quit()
    }
    if^love.timer.getTime() - began > 300 { fail($"replay round trip timeout at phase {phase}") }
}
public^let^draw = p^{ vp.main.draw() }
public^let^quit = p^-> bool^{ return^vp.main.quit() }
