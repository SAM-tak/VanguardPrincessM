# Run through tools/test-async.ps1: it inlines this harness into the real main
# unit so vp.main itself reloads. The module references also allow static analysis.
module^vp.f8mainreloadtest
import^love.event
import^love.keyboard
import^love.timer
require^"../main.lh"
require^"../src/arena.lh"
require^"../src/resource.lh"
require^"../tests/reload-state.lh"
let^checkpoint = vp.reloadstate.flow
public^let^load = p^{
    checkpoint.loads += 1
    if^checkpoint.loads = 1 { checkpoint.began := love.timer.getTime() }
    if^checkpoint.loads > 3 { panic^"Unexpected extra reload" }
    vp.main.load()
}
public^let^update = p^dt:number^{
    vp.main.update(0.02)
    if^vp.arena.names() = "system / opening" {
        if^checkpoint.loads = 3 {
            if^vp.resource.outstanding() != 0 or^vp.main.status().paused { panic^"Reload left jobs or pause state" }
            print("PASS: actual main unit reloads twice; task pool restarts after the frame boundary")
            love.event.quit()
        else^:
            checkpoint.phase := checkpoint.loads
            vp.main.keypressed(love.keyboard.Key.f8, love.keyboard.Scancode.unknown, false^)
            # A key event can precede update in the same frame. Exercise that
            # path so an empty pump cannot restart the pool before host stop.
            vp.main.update(0.02)
        }
    }
    if^love.timer.getTime() - checkpoint.began > 60 { panic^"main reload timeout" }
}
public^let^draw = p^{ vp.main.draw() }
