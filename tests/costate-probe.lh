# A character's running skill (src/script.lh's run, with show / hold awaited
# under it) goes back to where it stood with its coroutine's save() / load()
# (L^ 02 15.16): the frames after a restore show the same images as the
# frames after the save did.
module^vp.costateprobe
import^love.event
require^"../src/fighter.lh"
require^"../src/script.lh"
require^"../src/rng.lh"
require^"../src/stage.lh"
let^Fighter = vp.fighter.Fighter

let^SAVE_AT = 7               # inside an image's hold
let^AFTER = 120

let^probe = p^n:number^{
    let^a = Fighter.new("assets/characters/ゆい", 500, 920)
    let^sc = vp.script.load("assets/characters/ゆい/script.lton")
    if^sc is^nil^ { panic^"Missing script" }
    sc.install(a)
    a.begin(n)
    for^i from^1 to^SAVE_AT { a.stepScript() }
    let^co = a.skill
    if^co is^nil^ { panic^"no running skill at the save" }
    var^state : costate^|nil^= nil^
    if^co fits^c^{p^-> nil^} { state := co.save() elseif^co fits^c^{p^-> nil^ -> -}: state := co.save() }
    let^skillNo = a.skillNo
    let^image = a.image
    let^timer = a.waitTimer
    let^ix = a.ix
    let^iy = a.iy
    # The random state is not the frame's (a later step puts it in the snapshot).
    vp.rng.seed(42)
    var^first : t^{string^[]} = {}
    for^i from^1 to^AFTER {
        a.stepScript()
        first.push^($"{a.skillNo}:{a.image}")
    }
    # Put the frame back, and what the frame does not hold.
    a.skill := co
    let^saved = state
    if^saved is^nil^ { panic^"nothing saved" }
    if^co fits^c^{p^-> nil^} { co.load(saved) elseif^co fits^c^{p^-> nil^ -> -}: co.load(saved) }
    a.skillNo := skillNo
    a.image := image
    a.waitTimer := timer
    a.ix := ix
    a.iy := iy
    a.jumpSkill := -1
    a.eventPending := false^
    vp.rng.seed(42)
    var^second : t^{string^[]} = {}
    for^i from^1 to^AFTER {
        a.stepScript()
        second.push^($"{a.skillNo}:{a.image}")
    }
    var^changes = 0
    for^s in^first {
        if^second[index^] != s {
            panic^$"skill #{n}: frame {index^ + 1} after the restore: {second[index^] ?? "-"}, after the save: {s}"
        }
        if^index^ > 0 and^first[index^ - 1] != s { changes += 1 }
    }
    if^changes < 3 { panic^$"skill #{n} hardly moved ({changes} changes): not a test of the hold" }
    print($"skill #{n}: {changes} image changes in {AFTER} frames match after the restore")
}

let^probeBranches = p^{
    vp.fighter.clearSystemVars()
    vp.fighter.setRound(500, 1)
    vp.rng.seed(42)
    let^stage = vp.stage.load("assets/stages/ラスト")
    for^i from^1 to^SAVE_AT { stage.step() }
    let^random = vp.rng.get()
    let^vars = vp.fighter.systemVarsCopy()
    var^stores : t^{Fighter[]} = {}
    var^states : t^{(costate^|nil^)[]} = {}
    for^layer in^stage.layers {
        let^store = Fighter.new(layer.dir, 0, 0)
        layer.copyStateTo(store)
        stores.push^(store)
        let^co = layer.skill
        var^state : costate^|nil^= nil^
        if^co fits^c^{p^-> nil^} { state := co.save() elseif^co fits^c^{p^-> nil^ -> -}: state := co.save() }
        states.push^(state)
    }
    let^trace = p^-> string^{
        var^out = $"{vp.rng.get()}"
        for^layer in^stage.layers { out := $"{out} {layer.skillNo}:{layer.image}:{layer.waitTimer}:{layer.v(0)}:{layer.v(1)}" }
        return^out
    }
    var^first : t^{string^[]} = {}
    for^i from^1 to^AFTER { stage.step() first.push^(trace()) }
    for^pass from^1 to^2 {
        vp.rng.set(random)
        vp.fighter.setSystemVars(vars)
        for^layer in^stage.layers {
            let^store = stores[index^]
            let^state = states[index^]
            if^store != nil^ { store.copyStateTo(layer) }
            let^co = layer.skill
            if^state != nil^ {
                if^co fits^c^{p^-> nil^} { co.load(state) elseif^co fits^c^{p^-> nil^ -> -}: co.load(state) }
            }
        }
        for^i from^0 to^AFTER - 1 {
            stage.step()
            let^now = trace()
            if^now != first[i] { panic^$"branching stage, restore {pass}, frame {i}: {now} / {first[i] ?? "-"}" }
        }
    }
    print("branching stage: random state, images and variables match after two restores")
}

public^let^load = p^{
    probe(1)        # standing
    probe(2)        # walking forward
    probeBranches()
    print("PASS: a running skill's coroutine (run / show / hold) goes back with save() / load()")
    love.event.quit()
}
public^let^draw = p^{}
