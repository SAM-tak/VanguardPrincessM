# The port's own changes in the original locale (src/locale.lh): text the
# original never had, and captions reworded for them.

# PRACTICE MODE, the mode menu's third item (TechnicalDocuments/0145): drawn
# under the background's STORY MODE / VS MODE, in a widened, slanted face
# like theirs.
["locale:mode-menu/practice"] = {
    text = "PRACTICE  MODE",
    size = { 260, 26 }, rect = { 2, 3, 250, 20 }, align = "left", valign = "middle",
    stretch = 1.6, skew = 0.25,
    font = "data/montserrat/Montserrat-Bold.ttf", fontSize = 12,
    color = { 0.08, 0.07, 0.07 }, outline = { color = { 1, 0.88, 0.72 }, width = 1 },
},

# Its caption, where system #107 shows the others; and VS's, no longer about
# practice (system 0168: 「対人戦や技の練習を行います。」).
["locale:mode-menu/practice-caption"] = {
    text = "技の練習を行います。",
    size = { 300, 18 }, rect = { 0, 2, 300, 14 }, align = "left", valign = "middle",
    offset = { 0, -2 }, weight = 1.5,
    font = "data/NotoSansMonoCJKjp-Regular.otf", fontSize = 14,
    color = { 0, 0, 0.03 },
},
["assets/system/ヴァンガードプリンセス/images/0168.dds"] = {
    text = "対人戦を行います。",
    size = { 300, 18 }, rect = { 0, 2, 300, 14 }, align = "left", valign = "middle",
    offset = { 0, -2 }, weight = 1.5,
    font = "data/NotoSansMonoCJKjp-Regular.otf", fontSize = 14,
    color = { 0, 0, 0.03 },
},
