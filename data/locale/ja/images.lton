["locale:mode-menu/story"] = {
    text = "STORY  MODE",
    size = { 260, 26 }, rect = { 2, 3, 250, 20 }, align = "left", valign = "middle",
    stretch = 1.4, skew = 0.25,
    font = "data/montserrat/Montserrat-Regular.ttf", fontSize = 16,
    color = { 0.08, 0.07, 0.07 }, outline = { color = { 1, 0.88, 0.72 }, width = 1 },
},
["locale:mode-menu/vs"] = {
    text = "VS  MODE",
    size = { 260, 26 }, rect = { 2, 3, 250, 20 }, align = "left", valign = "middle",
    stretch = 1.4, skew = 0.25,
    font = "data/montserrat/Montserrat-Regular.ttf", fontSize = 16,
    color = { 0.08, 0.07, 0.07 }, outline = { color = { 1, 0.88, 0.72 }, width = 1 },
},
["locale:mode-menu/practice"] = {
