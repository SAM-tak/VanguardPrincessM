# English replacements for images with Japanese text (src/locale.lh).
# Keyed by the image file's path; drawn once into a canvas of `size`.
#
# HUD name plates (TechnicalDocuments/0144): a character's name ends at
# x = 118 (1P; 2P at 490, within a pixel or two, as the same image serves
# both) whatever the original's width, with room for italics' overhang;
# "and <support>" starts where the original starts (x = 120 / 491; 252, at
# 479 in the original, is moved to 491). Every plate's top is at y = 22, which
# centres the letters where the originals' are (y 26-37).
# image 241
["assets/system/ヴァンガードプリンセス/images/0241.png"] = {
    text = "Yui",
    size = { 60, 17 }, rect = { 1, 1, 55, 15 }, align = "right", valign = "middle",
    offset = { -28, -3 },
    font = "data/Playfair_Display/static/PlayfairDisplay-BoldItalic.ttf", fontSize = 13,
    color = { 1, 1, 1 }, outline = { color = { 0.2, 0.12, 0.62 }, width = 1 },
},
